+		return true
+	}
+	return strings.HasPrefix(name, "x-envoy-") || strings.HasPrefix(name, "x-istio-") ||
+		strings.HasPrefix(name, "x-forwarded-") || strings.HasPrefix(name, "grpc-") ||
+		strings.HasPrefix(name, "sec-websocket-")
