 )
 
+// WaypointMainInternal is the listener containing the waypoint's per-Service HTTP chains.
+const WaypointMainInternal = "main_internal"
+
+// PatchesWaypointHTTPChain reports whether an inbound patch can change the listener
+// or Service chain. Its generated filter chains have names but no FilterChainMatch.
+// Patch contents and replica-specific proxy metadata cannot be certified at admission.
+func PatchesWaypointHTTPChain(patches map[networking.EnvoyFilter_ApplyTo][]*model.EnvoyFilterConfigPatchWrapper, chainName string) bool {
+	lis := &listener.Listener{Name: WaypointMainInternal}
+	chain := &listener.FilterChain{Name: chainName}
+	for applyTo, entries := range patches {
+		switch applyTo {
+		case networking.EnvoyFilter_LISTENER, networking.EnvoyFilter_LISTENER_FILTER, networking.EnvoyFilter_FILTER_CHAIN,
+			networking.EnvoyFilter_NETWORK_FILTER, networking.EnvoyFilter_HTTP_FILTER:
+		default:
+			continue
+		}
+		for _, patch := range entries {
+			if patch.ProxyVersionNoMatch || !patchContextMatch(networking.EnvoyFilter_SIDECAR_INBOUND, patch) || !listenerMatch(lis, patch) {
+				continue
+			}
+			// A new listener is separate. A new filter chain changes the matched listener.
+			if patch.Operation == networking.EnvoyFilter_Patch_ADD {
+				switch applyTo {
+				case networking.EnvoyFilter_LISTENER:
+					continue
+				case networking.EnvoyFilter_FILTER_CHAIN:
+					return true
+				}
+			}
+			if applyTo == networking.EnvoyFilter_LISTENER || applyTo == networking.EnvoyFilter_LISTENER_FILTER || filterChainMatch(lis, chain, patch) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// patchesWaypointHCMRouteSource reports whether a matching network filter patch
+// replaces the inline route configuration generated for this HTTP chain.
+func patchesWaypointHCMRouteSource(patches []*model.EnvoyFilterConfigPatchWrapper, chainName string) bool {
+	lis := &listener.Listener{Name: WaypointMainInternal}
+	chain := &listener.FilterChain{Name: chainName}
+	filter := &listener.Filter{Name: wellknown.HTTPConnectionManager}
+	for _, patch := range patches {
+		if patch.ProxyVersionNoMatch || !patchContextMatch(networking.EnvoyFilter_SIDECAR_INBOUND, patch) ||
+			!listenerMatch(lis, patch) || !filterChainMatch(lis, chain, patch) || !networkFilterMatch(filter, patch) {
+			continue
+		}
+		switch patch.Operation {
+		case networking.EnvoyFilter_Patch_MERGE:
+		case networking.EnvoyFilter_Patch_REPLACE:
+			if !hasNetworkFilterMatch(patch) {
+				continue
+			}
+		default:
+			continue
+		}
+		manager := &hcm.HttpConnectionManager{}
+		value := patch.Value.(*listener.Filter).GetTypedConfig()
+		if value == nil || value.UnmarshalTo(manager) != nil {
+			continue
+		}
+		// A merge of an inline RouteConfiguration keeps the generated oneof
+		// member. RDS and scoped routes switch to a different member.
+		if manager.GetRds() != nil || manager.GetScopedRoutes() != nil ||
+			patch.Operation == networking.EnvoyFilter_Patch_REPLACE && manager.GetRouteConfig() != nil {
+			return true
+		}
+	}
+	return false
+}
