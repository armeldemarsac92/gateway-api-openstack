+	wait(only, false, true, false, 0, 80)
+	primaryJWT = policies.Get(gvk.RequestAuthentication, jwt.Name, jwt.Namespace).DeepCopy()
+	primaryJWT.Spec = unrelated.Spec
+	_, err = policies.Update(primaryJWT)
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 80)
+	wait(only, true, true, false, 1, 80)
+	assert.NoError(t, policies.Delete(gvk.RequestAuthentication, jwt.Name, jwt.Namespace, nil))
+	wait(mixed, true, true, true, 2, 80)
+	wait(only, false, true, false, 0, 80)
+	assert.Equal(t, projectedRules("producer", 0), 1)
+
+	ctx := context.Background()
+	// Persist the partial condition as the real status writer would, so the
+	// restoration also exercises removal of a previously published condition.
+	client := kc.GatewayAPI().GatewayV1().HTTPRoutes(mixed.Namespace)
+	current, err := client.Get(ctx, mixed.Name, metav1.GetOptions{})
+	assert.NoError(t, err)
+	queue.mu.Lock()
+	for key, value := range queue.state {
+		if key.Namespace == mixed.Namespace && key.Name == mixed.Name {
+			current.Status = *value.(*gatewayv1.HTTPRouteStatus).DeepCopy()
+		}
+	}
+	queue.mu.Unlock()
+	_, err = client.UpdateStatus(ctx, current, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+
+	// The ambient index withdraws a cross-namespace attachment when allowedRoutes changes.
+	// A Gateway policy stays installed throughout denial and reattachment.
+	denied := info
+	denied.Waypoint = model.WaypointBindingStatus{Error: ambient.ReportWaypointAttachmentDenied(info.Waypoint.ResourceName)}
+	discovery.UpdateObject(denied)
+	wait(mixed, true, false, false, 3, 80)
+	wait(only, true, false, false, 1, 80)
+	serviceJWT := jwt.DeepCopy()
+	serviceJWT.Namespace = string(ns)
+	serviceJWT.Name = "service-jwt"
+	serviceJWT.Spec.(*security.RequestAuthentication).TargetRefs = []*typepb.PolicyTargetReference{{Kind: "Service", Name: "api"}}
+	_, err = policies.Create(serviceJWT)
+	assert.NoError(t, err)
+	wait(only, false, false, false, 0, 80)
+	assert.NoError(t, policies.Delete(gvk.RequestAuthentication, serviceJWT.Name, serviceJWT.Namespace, nil))
+	wait(only, true, false, false, 1, 80)
+	discovery.UpdateObject(info)
+	wait(only, false, true, false, 0, 80)
+
+	_, err = policies.Create(config.Config{
+		Meta: config.Meta{GroupVersionKind: gvk.AuthorizationPolicy, Namespace: string(ns), Name: "custom"},
+		Spec: &security.AuthorizationPolicy{
+			Action:     security.AuthorizationPolicy_CUSTOM,
+			Rules:      []*security.Rule{{To: []*security.Rule_To{{Operation: &security.Operation{Methods: []string{"GET"}}}}}},
+			TargetRefs: []*typepb.PolicyTargetReference{{Kind: "Service", Name: "api"}},
+			ActionDetail: &security.AuthorizationPolicy_Provider{
+				Provider: &security.AuthorizationPolicy_ExtensionProvider{Name: "test-authorizer"},
+			},
+		},
+	})
+	assert.NoError(t, err)
+	wait(mixed, true, true, true, 1, 80)
+	assert.NoError(t, secondary.Delete(gvk.RequestAuthentication, jwt.Name, jwt.Namespace, nil))
+	wait(mixed, true, true, false, 3, 80)
+	wait(only, true, true, false, 1, 80)
+
+	// A client-only extension on this Service does not select the inbound listener.
+	lua := config.Config{
+		Meta: config.Meta{GroupVersionKind: gvk.TrafficExtension, Name: "owner-lua", Namespace: string(ns)},
+		Spec: &extapi.TrafficExtension{
+			TargetRefs:   []*typepb.PolicyTargetReference{{Kind: "Service", Name: "api"}},
+			Phase:        extapi.TrafficExtension_STATS,
+			Match:        []*extapi.TrafficSelector{{Mode: typepb.WorkloadMode_SERVER}},
+			FilterConfig: &extapi.TrafficExtension_Lua{Lua: &extapi.LuaConfig{InlineCode: "function envoy_on_request(handle) end"}},
+		},
+	}
+	_, err = secondary.Create(lua)
+	assert.NoError(t, err)
+	wait(mixed, true, true, true, 1, 80)
+	wait(only, false, true, false, 0, 80)
+	currentLua := secondary.Get(gvk.TrafficExtension, lua.Name, lua.Namespace).DeepCopy()
+	currentLua.Spec.(*extapi.TrafficExtension).Match[0].Mode = typepb.WorkloadMode_CLIENT
+	_, err = secondary.Update(currentLua)
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 80)
+	wait(only, true, true, false, 1, 80)
+	assert.NoError(t, secondary.Delete(gvk.TrafficExtension, lua.Name, lua.Namespace, nil))
+
+	value, err := structpb.NewStruct(map[string]any{"name": "main_internal", "traffic_direction": "INBOUND"})
+	assert.NoError(t, err)
+	patch := config.Config{
+		Meta: config.Meta{GroupVersionKind: gvk.EnvoyFilter, Name: "owner-listener", Namespace: waypoint.Namespace},
+		Spec: &istio.EnvoyFilter{
+			TargetRefs: []*typepb.PolicyTargetReference{{Group: gvk.KubernetesGateway.Group, Kind: "Gateway", Name: waypoint.Name}},
+			ConfigPatches: []*istio.EnvoyFilter_EnvoyConfigObjectPatch{{
+				ApplyTo: istio.EnvoyFilter_LISTENER,
+				Match: &istio.EnvoyFilter_EnvoyConfigObjectMatch{Context: istio.EnvoyFilter_SIDECAR_INBOUND,
+					ObjectTypes: &istio.EnvoyFilter_EnvoyConfigObjectMatch_Listener{Listener: &istio.EnvoyFilter_ListenerMatch{Name: "main_internal"}}},
+				Patch: &istio.EnvoyFilter_Patch{Operation: istio.EnvoyFilter_Patch_MERGE, Value: value},
+			}},
+		},
+	}
+	_, err = policies.Create(patch)
+	assert.NoError(t, err)
+	wait(mixed, true, true, true, 1, 80)
+	wait(only, false, true, false, 0, 80)
+	// A selector Pilot skips for every proxy cannot withdraw request mutations.
+	skipped := policies.Get(gvk.EnvoyFilter, patch.Name, patch.Namespace).DeepCopy()
+	skipped.Spec.(*istio.EnvoyFilter).ConfigPatches[0].Match.Proxy = &istio.EnvoyFilter_ProxyMatch{
+		ProxyVersion: strings.Repeat("1", 1025),
+	}
+	_, err = policies.Update(skipped)
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 80)
+	wait(only, true, true, false, 1, 80)
+	assert.NoError(t, policies.Delete(gvk.EnvoyFilter, patch.Name, patch.Namespace, nil))
+
+	routeValue, err := structpb.NewStruct(map[string]any{"route": map[string]any{"timeout": "3s"}})
+	assert.NoError(t, err)
+	routePatch := patch.DeepCopy()
+	routePatch.Name = "owner-route"
+	routeMatch := &istio.EnvoyFilter_RouteConfigurationMatch{
+		Name: "inbound-vip|80|http|api.producer.svc.cluster.local", PortNumber: 80,
+		Vhost: &istio.EnvoyFilter_RouteConfigurationMatch_VirtualHostMatch{
+			Name: "inbound|http|80", DomainName: "*",
+			Route: &istio.EnvoyFilter_RouteConfigurationMatch_RouteMatch{Name: "default", Action: istio.EnvoyFilter_RouteConfigurationMatch_RouteMatch_ROUTE},
+		},
+	}
+	routePatch.Spec.(*istio.EnvoyFilter).ConfigPatches = []*istio.EnvoyFilter_EnvoyConfigObjectPatch{{
+		ApplyTo: istio.EnvoyFilter_HTTP_ROUTE,
+		Match: &istio.EnvoyFilter_EnvoyConfigObjectMatch{Context: istio.EnvoyFilter_SIDECAR_INBOUND,
+			ObjectTypes: &istio.EnvoyFilter_EnvoyConfigObjectMatch_RouteConfiguration{RouteConfiguration: routeMatch}},
+		Patch: &istio.EnvoyFilter_Patch{Operation: istio.EnvoyFilter_Patch_MERGE, Value: routeValue},
+	}}
+	_, err = policies.Create(routePatch)
+	assert.NoError(t, err)
+	wait(mixed, false, true, false, 0, 80)
+	wait(responseOnly, false, true, false, 0, 80)
+	wait(otherPort, true, true, false, 1, 8080)
+	assert.Equal(t, projectedRules("producer", 0), 1)
+
+	currentPatch := policies.Get(gvk.EnvoyFilter, routePatch.Name, routePatch.Namespace).DeepCopy()
+	currentPatch.Spec.(*istio.EnvoyFilter).ConfigPatches[0].Match.GetRouteConfiguration().Vhost.Route.Name = "other-route"
+	_, err = policies.Update(currentPatch)
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 80)
+	wait(responseOnly, true, true, false, 1, 80)
+
+	currentPatch = policies.Get(gvk.EnvoyFilter, routePatch.Name, routePatch.Namespace).DeepCopy()
+	entry := currentPatch.Spec.(*istio.EnvoyFilter).ConfigPatches[0]
+	entry.ApplyTo = istio.EnvoyFilter_VIRTUAL_HOST
+	entry.Match.GetRouteConfiguration().Vhost.Route = nil
+	entry.Patch = &istio.EnvoyFilter_Patch{Operation: istio.EnvoyFilter_Patch_REMOVE}
+	_, err = policies.Update(currentPatch)
+	assert.NoError(t, err)
+	wait(responseOnly, false, true, false, 0, 80)
+	wait(otherPort, true, true, false, 1, 8080)
+
+	// Configuration shared by both route branches is retained.
+	sharedValue, err := structpb.NewStruct(map[string]any{"max_direct_response_body_size_bytes": 4096})
+	assert.NoError(t, err)
+	currentPatch = policies.Get(gvk.EnvoyFilter, routePatch.Name, routePatch.Namespace).DeepCopy()
+	entry = currentPatch.Spec.(*istio.EnvoyFilter).ConfigPatches[0]
+	entry.ApplyTo = istio.EnvoyFilter_ROUTE_CONFIGURATION
+	entry.Match.GetRouteConfiguration().Vhost = nil
+	entry.Patch = &istio.EnvoyFilter_Patch{Operation: istio.EnvoyFilter_Patch_MERGE, Value: sharedValue}
+	_, err = policies.Update(currentPatch)
+	assert.NoError(t, err)
+	wait(responseOnly, true, true, false, 1, 80)
+	wait(mixed, true, true, false, 3, 80)
+
+	discovery.DeleteObject(info.ResourceName())
+	wait(mixed, true, false, false, 3, 80)
+	discovery.UpdateObject(info)
+	wait(mixed, true, true, false, 3, 80)
+
+	serviceClient := kc.Kube().CoreV1().Services(string(ns))
+	service, err = serviceClient.Get(ctx, service.Name, metav1.GetOptions{})
+	assert.NoError(t, err)
+	service.Labels[label.IoIstioUseWaypoint.Name] = "none"
+	_, err = serviceClient.Update(ctx, service, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 0)
+	assert.Equal(t, projectedRules(mixed.Namespace, 80), 0)
+}
