+// InboundVirtualHostName returns the default virtual host name for an inbound port.
+func InboundVirtualHostName(port int) string {
+	return string(model.TrafficDirectionInbound) + "|http|" + strconv.Itoa(port)
+}
+
+// PatchesWaypointHTTPRoutes reports whether a patch can replace the route source
+// or change the generated inbound fallback for this Kubernetes Service port.
+// A separate consumer route cannot carry arbitrary settings from the owner's
+// route or replace its matcher.
+// Settings shared by the whole route configuration or virtual host are retained.
+// Check the fallback even with an explicit producer route, which can be withdrawn.
+func PatchesWaypointHTTPRoutes(patches map[networking.EnvoyFilter_ApplyTo][]*model.EnvoyFilterConfigPatchWrapper, chainName string, port int) bool {
+	if patchesWaypointHCMRouteSource(patches[networking.EnvoyFilter_NETWORK_FILTER], chainName) {
+		return true
+	}
+	rc := &route.RouteConfiguration{Name: chainName}
+	vh := &route.VirtualHost{Name: InboundVirtualHostName(port), Domains: []string{"*"}}
+	r := &route.Route{Name: istio_route.DefaultRouteName, Action: &route.Route_Route{}}
+	for _, target := range []networking.EnvoyFilter_ApplyTo{
+		networking.EnvoyFilter_ROUTE_CONFIGURATION, networking.EnvoyFilter_VIRTUAL_HOST, networking.EnvoyFilter_HTTP_ROUTE,
+	} {
+		for _, patch := range patches[target] {
+			if patch.ProxyVersionNoMatch || !patchContextMatch(networking.EnvoyFilter_SIDECAR_INBOUND, patch) ||
+				!routeConfigurationMatch(networking.EnvoyFilter_SIDECAR_INBOUND, rc, patch, nil) {
+				continue
+			}
+			op := patch.Operation
+			switch target {
+			case networking.EnvoyFilter_ROUTE_CONFIGURATION:
+				if isMergeOperation(op) {
+					value := patch.Value.(*route.RouteConfiguration)
+					if len(value.VirtualHosts) != 0 || value.Name != "" && value.Name != rc.Name {
+						return true
+					}
+				}
+			case networking.EnvoyFilter_VIRTUAL_HOST:
+				if op == networking.EnvoyFilter_Patch_ADD {
+					return true
+				}
+				if !virtualHostMatch(vh, patch) {
+					continue
+				}
+				if op == networking.EnvoyFilter_Patch_REMOVE || op == networking.EnvoyFilter_Patch_REPLACE {
+					return true
+				}
+				if isMergeOperation(op) {
+					value := patch.Value.(*route.VirtualHost)
+					if value.Matcher != nil || len(value.Routes) != 0 || len(value.Domains) != 0 || value.Name != "" && value.Name != vh.Name {
+						return true
+					}
+				}
+			case networking.EnvoyFilter_HTTP_ROUTE:
+				if !virtualHostMatch(vh, patch) {
+					continue
+				}
+				switch op {
+				case networking.EnvoyFilter_Patch_ADD:
+					return true
+				case networking.EnvoyFilter_Patch_MERGE, networking.EnvoyFilter_Patch_MERGE_AND_REPLACE_LIST,
+					networking.EnvoyFilter_Patch_REMOVE, networking.EnvoyFilter_Patch_INSERT_BEFORE,
+					networking.EnvoyFilter_Patch_INSERT_AFTER, networking.EnvoyFilter_Patch_INSERT_FIRST:
+					if routeMatch(r, patch) {
+						return true
+					}
+				}
+			}
+		}
+	}
+	return false
+}
