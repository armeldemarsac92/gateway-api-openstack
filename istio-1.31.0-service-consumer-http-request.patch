+func (policies *waypointConsumerPolicies) requestHeaderError(rule gatewayv1.HTTPRouteRule, chain string) string {
+	for _, filter := range rule.Filters {
+		headers := filter.RequestHeaderModifier
+		if filter.Type != gatewayv1.HTTPRouteFilterRequestHeaderModifier || headers == nil ||
+			len(headers.Set)+len(headers.Add)+len(headers.Remove) == 0 {
+			continue
+		}
+		if policies.incompatible != "" {
+			return policies.incompatible
+		}
+		for _, filter := range policies.envoyFilters {
+			if envoyfilter.PatchesWaypointHTTPChain(filter.Patches, chain) {
+				return "an attached EnvoyFilter can patch the waypoint HTTP chain"
+			}
+		}
+		if name := waypointConsumerManagedHeader(headers, policies.jwtHeaders); name != "" {
+			return fmt.Sprintf("request header %q is managed by an attached RequestAuthentication", name)
+		}
+	}
+	return ""
+}
+
+func waypointConsumerManagedHeader(headers *gatewayv1.HTTPHeaderFilter, jwtHeaders sets.String) string {
+	for _, operations := range [][]gatewayv1.HTTPHeader{headers.Set, headers.Add} {
+		for _, header := range operations {
+			name := string(header.Name)
+			if jwtHeaders.Contains(model.NormalizeAuthenticationHeader(name)) {
+				return name
+			}
+		}
+	}
+	for _, name := range headers.Remove {
+		if jwtHeaders.Contains(model.NormalizeAuthenticationHeader(name)) {
+			return name
+		}
+	}
+	return ""
+}
