+			Action: &mutationrules.HeaderMutation_Remove{Remove: strings.ToLower(name)},
+		})
+	}
+	for _, header := range headers.RequestHeadersToAdd {
+		mutations = append(mutations, &mutationrules.HeaderMutation{
+			Action: &mutationrules.HeaderMutation_Append{Append: header},
+		})
+	}
+	return protoconv.MessageToAny(&header_mutationv3.HeaderMutationPerRoute{
+		Mutations: &header_mutationv3.Mutations{RequestMutations: mutations},
+	})
