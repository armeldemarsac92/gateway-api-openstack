+// RequestAuthenticationHeaders lists the input and output headers managed by
+// the selected JWT policies. JWT on a waypoint can invalidate the route cache.
+func RequestAuthenticationHeaders(policies []*config.Config) (sets.String, bool) {
+	headers := sets.New[string]()
+	hasJWT := false
+	for _, policy := range policies {
+		for _, rule := range policy.Spec.(*v1beta1.RequestAuthentication).GetJwtRules() {
+			hasJWT = true
+			if name := rule.GetOutputPayloadToHeader(); name != "" {
+				headers.Insert(NormalizeAuthenticationHeader(name))
+			}
+			for _, header := range rule.GetFromHeaders() {
+				headers.Insert(NormalizeAuthenticationHeader(header.GetName()))
+			}
+			for _, claim := range rule.GetOutputClaimToHeaders() {
+				headers.Insert(NormalizeAuthenticationHeader(claim.GetHeader()))
+			}
+		}
+	}
+	return headers, hasJWT
+}
+
+// NormalizeAuthenticationHeader also accounts for applications that treat
+// hyphens and underscores as equivalent in HTTP header names.
+func NormalizeAuthenticationHeader(name string) string {
+	return strings.ReplaceAll(strings.ToLower(name), "_", "-")
+}
