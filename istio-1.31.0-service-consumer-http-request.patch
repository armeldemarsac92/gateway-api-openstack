+
+	ns, port := gatewayv1.Namespace("producer"), gatewayv1.PortNumber(80)
+	parent := gatewayv1.ParentReference{
+		Group: ptr.Of(gatewayv1.Group("")), Kind: ptr.Of(gatewayv1.Kind("Service")),
+		Name: "api", Namespace: &ns, Port: &port,
+	}
+	direct := gatewayv1.HTTPRouteRule{
+		BackendRefs: []gatewayv1.HTTPBackendRef{{BackendRef: gatewayv1.BackendRef{
+			BackendObjectReference: gatewayv1.BackendObjectReference{Name: "api", Namespace: &ns, Port: &port},
+		}}},
+	}
+	modify := func(name gatewayv1.HTTPHeaderName) gatewayv1.HTTPRouteRule {
+		rule := direct.DeepCopy()
+		rule.Filters = []gatewayv1.HTTPRouteFilter{{
+			Type:                  gatewayv1.HTTPRouteFilterRequestHeaderModifier,
+			RequestHeaderModifier: &gatewayv1.HTTPHeaderFilter{Set: []gatewayv1.HTTPHeader{{Name: name, Value: "test"}}},
+		}}
+		return *rule
+	}
+	route := func(namespace, name string, rules ...gatewayv1.HTTPRouteRule) *gatewayv1.HTTPRoute {
+		return &gatewayv1.HTTPRoute{
+			ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: name, Generation: 1},
+			Spec: gatewayv1.HTTPRouteSpec{
+				CommonRouteSpec: gatewayv1.CommonRouteSpec{ParentRefs: []gatewayv1.ParentReference{parent}},
+				Rules:           rules,
+			},
+		}
+	}
+	mixed := route("consumer", "mixed", direct, modify("X-Owner-Claim"), modify("X-Business"))
+	only := route("another-client", "only", modify("X-Owner-Claim"))
+	service := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{Name: "api", Namespace: string(ns), Labels: map[string]string{label.IoIstioUseWaypoint.Name: "waypoint"}},
+		Spec:       corev1.ServiceSpec{ClusterIP: "1.2.3.4", Ports: []corev1.ServicePort{{Name: "http", Port: 80, Protocol: corev1.ProtocolTCP}}},
+	}
+	class := &gatewayv1.GatewayClass{ObjectMeta: metav1.ObjectMeta{Name: "mesh"},
+		Spec: gatewayv1.GatewayClassSpec{ControllerName: constants.ManagedGatewayMeshController}}
+	waypoint := &gatewayv1.Gateway{
+		ObjectMeta: metav1.ObjectMeta{Namespace: string(ns), Name: "waypoint"},
+		Spec:       gatewayv1.GatewaySpec{GatewayClassName: "mesh", Listeners: []gatewayv1.Listener{{Name: "mesh", Port: 15008, Protocol: "HBONE"}}},
+		Status: gatewayv1.GatewayStatus{Addresses: []gatewayv1.GatewayStatusAddress{{
+			Type: ptr.Of(gatewayv1.HostnameAddressType), Value: "waypoint.producer.svc.cluster.local",
+		}}},
+	}
+	kc := kubelibrary.NewFakeClient(mixed, only, route("producer", "owner", direct), service, class, waypoint,
+		&corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: "producer"}})
+	setupClientCRDs(t, kc)
+	policies := memory.NewController(memory.Make(collections.Pilot))
+	jwt := config.Config{
+		Meta: config.Meta{GroupVersionKind: gvk.RequestAuthentication, Namespace: string(ns), Name: "jwt"},
+		Spec: &security.RequestAuthentication{
+			TargetRefs: []*typepb.PolicyTargetReference{{Group: gvk.KubernetesGateway.Group, Kind: "Gateway", Name: "waypoint"}},
+			JwtRules:   []*security.JWTRule{{Issuer: "example.ietf.org", OutputClaimToHeaders: []*security.ClaimToHeader{{Header: "x-owner-claim", Claim: "sub"}}}},
+		},
+	}
+	unrelated := jwt.DeepCopy()
+	unrelated.Name = "other-gateway"
+	unrelated.Spec.(*security.RequestAuthentication).TargetRefs[0].Name = "elsewhere"
+	_, err := policies.Create(unrelated)
+	assert.NoError(t, err)
+
+	stop := test.NewStop(t)
+	c := NewController(kc, func(schema.GroupVersionResource, <-chan struct{}) bool { return false },
+		controller.Options{DomainSuffix: "cluster.local", MeshWatcher: meshwatcher.NewTestWatcher(nil)}, nil, policies)
+	discovery := krt.NewStaticCollection[model.ServiceInfo](nil, nil, krt.WithStop(stop))
+	c.SetAmbientServices(discovery)
+	kc.RunAndWait(stop)
+	go c.Run(stop)
+	go policies.Run(stop)
+	c.Reconcile(core.NewConfigGenTest(t, core.TestOptions{}).PushContext())
+	queue := &TestStatusQueue{state: map[status.Resource]any{}}
+	setAndWait(t, c, queue)
+	projectedRules := func(namespace string, port uint32) int {
+		count := 0
+		for _, vs := range c.List(gvk.VirtualService, namespace) {
+			binding, _ := vs.Extra[constants.ConfigExtraMeshConsumerService].(kube.MeshConsumerService)
+			if vs.Namespace == namespace && binding.Port == port {
+				count += len(vs.Spec.(*istio.VirtualService).GetHttp())
+			}
+		}
+		return count
+	}
+	wait := func(obj *gatewayv1.HTTPRoute, accepted, waypointResolved, partial bool, rules int, port uint32) {
+		t.Helper()
+		assert.EventuallyEqual(t, func() bool {
+			queue.mu.Lock()
+			defer queue.mu.Unlock()
+			for key, value := range queue.state {
+				if key.Namespace != obj.Namespace || key.Name != obj.Name {
+					continue
+				}
+				st, ok := value.(*gatewayv1.HTTPRouteStatus)
+				if !ok || len(st.Parents) != 1 {
+					return false
+				}
+				conds := st.Parents[0].Conditions
+				acceptedCondition := meta.FindStatusCondition(conds, "Accepted")
+				waypointCondition := meta.FindStatusCondition(conds, string(RouteConditionResolvedWaypoints))
+				incomplete := meta.FindStatusCondition(conds, string(gatewayv1.RouteConditionPartiallyInvalid))
+				return acceptedCondition != nil && (acceptedCondition.Status == metav1.ConditionTrue) == accepted &&
+					(accepted || acceptedCondition.Reason == "UnsupportedValue") &&
+					waypointCondition != nil && (waypointCondition.Status == metav1.ConditionTrue) == waypointResolved &&
+					((!partial && incomplete == nil) || (partial && incomplete != nil && incomplete.Status == metav1.ConditionTrue &&
+						strings.HasPrefix(incomplete.Message, "Dropped Rule") && incomplete.ObservedGeneration == obj.Generation))
+			}
+			return false
+		}, true)
+		assert.EventuallyEqual(t, func() int { return projectedRules(obj.Namespace, port) }, rules)
+	}
+	wait(mixed, true, false, false, 3, 80)
+
+	info := model.ServiceInfo{
+		Source:   model.TypedObject{Kind: kind.Service, NamespacedName: types.NamespacedName{Namespace: string(ns), Name: "api"}},
+		Waypoint: model.WaypointBindingStatus{ResourceName: "producer/waypoint"},
+		Service: &workloadapi.Service{
+			Name: "api", Namespace: string(ns), Hostname: "api.producer.svc.cluster.local",
+			Addresses: []*workloadapi.NetworkAddress{{Address: netip.MustParseAddr("1.2.3.4").AsSlice()}},
+			Ports:     []*workloadapi.Port{{ServicePort: 80}},
+			Waypoint: &workloadapi.GatewayAddress{
+				Destination: &workloadapi.GatewayAddress_Hostname{Hostname: &workloadapi.NamespacedHostname{
+					Namespace: string(ns), Hostname: "waypoint.producer.svc.cluster.local",
+				}},
+				HboneMtlsPort: 15008,
+			},
+		},
+	}
+	discovery.UpdateObject(info)
+	wait(mixed, true, true, false, 3, 80)
+	_, err = policies.Create(jwt)
+	assert.NoError(t, err)
+	wait(mixed, true, true, true, 2, 80)
+	wait(only, false, true, false, 0, 80)
+	assert.Equal(t, projectedRules("producer", 0), 1)
+
+	ctx := context.Background()
+	// Persist the partial condition as the real status writer would, so the
+	// restoration also exercises removal of a previously published condition.
+	client := kc.GatewayAPI().GatewayV1().HTTPRoutes(mixed.Namespace)
+	current, err := client.Get(ctx, mixed.Name, metav1.GetOptions{})
+	assert.NoError(t, err)
+	queue.mu.Lock()
+	for key, value := range queue.state {
+		if key.Namespace == mixed.Namespace && key.Name == mixed.Name {
+			current.Status = *value.(*gatewayv1.HTTPRouteStatus).DeepCopy()
+		}
+	}
+	queue.mu.Unlock()
+	_, err = client.UpdateStatus(ctx, current, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+
+	_, err = policies.Create(config.Config{
+		Meta: config.Meta{GroupVersionKind: gvk.AuthorizationPolicy, Namespace: string(ns), Name: "custom"},
+		Spec: &security.AuthorizationPolicy{
+			Action:     security.AuthorizationPolicy_CUSTOM,
+			TargetRefs: []*typepb.PolicyTargetReference{{Kind: "Service", Name: "api"}},
+			ActionDetail: &security.AuthorizationPolicy_Provider{
+				Provider: &security.AuthorizationPolicy_ExtensionProvider{Name: "test-authorizer"},
+			},
+		},
+	})
+	assert.NoError(t, err)
+	wait(mixed, true, true, true, 1, 80)
+	assert.NoError(t, policies.Delete(gvk.RequestAuthentication, jwt.Name, jwt.Namespace, nil))
+	wait(mixed, true, true, false, 3, 80)
+	wait(only, true, true, false, 1, 80)
+
+	discovery.DeleteObject(info.ResourceName())
+	wait(mixed, true, false, false, 3, 80)
+	discovery.UpdateObject(info)
+	wait(mixed, true, true, false, 3, 80)
+
+	serviceClient := kc.Kube().CoreV1().Services(string(ns))
+	service, err = serviceClient.Get(ctx, service.Name, metav1.GetOptions{})
+	assert.NoError(t, err)
+	service.Labels[label.IoIstioUseWaypoint.Name] = "none"
+	_, err = serviceClient.Update(ctx, service, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	wait(mixed, true, true, false, 3, 0)
+	assert.Equal(t, projectedRules(mixed.Namespace, 80), 0)
+}
