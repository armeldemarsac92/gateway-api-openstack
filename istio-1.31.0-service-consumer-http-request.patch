+func (c *Controller) SetWaypointPolicyStore(store model.ConfigStoreController) {
+	p := c.waypointPolicies.AccessUnprotected()
+	if p == nil {
+		return
+	}
+	index := func(kind config.GroupVersionKind) krt.Index[string, config.Config] {
+		col := store.KrtCollection(kind)
+		if col == nil {
+			return nil
+		}
+		return krt.NewNamespaceIndex(col)
+	}
+	p.Store(&waypointPolicyIndexes{
+		requestAuthentication: index(gvk.RequestAuthentication),
+		authorizationPolicy:   index(gvk.AuthorizationPolicy),
+		trafficExtension:      index(gvk.TrafficExtension),
+		envoyFilter:           index(gvk.EnvoyFilter),
+	})
+	c.waypointPolicies.TriggerRecomputation()
