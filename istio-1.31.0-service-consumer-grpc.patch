+func (ctx RouteContext) waypointConsumerGRPCBinding(svc *corev1.Service, waypointNamespace, waypointName string) (*model.ServiceInfo, *WaypointError) {
+	waypoint := waypointNamespace + "/" + waypointName
+	missing := &WaypointError{
+		Reason:  "NoEffectiveServiceWaypoint",
+		Message: fmt.Sprintf("Service %s/%s does not have the active Service waypoint %q", svc.Namespace, svc.Name, waypoint),
+	}
+	if ctx.Gateways == nil || ctx.GatewayClasses == nil || ctx.ambientServices.AccessUnprotected() == nil {
+		return nil, missing
+	}
+	gateway := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.Gateways, krt.FilterKey(waypoint)))
+	if gateway == nil || gateway.DeletionTimestamp != nil || len(gateway.Status.Addresses) == 0 {
+		return nil, missing
+	}
+	class := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.GatewayClasses, krt.FilterKey(string(gateway.Spec.GatewayClassName))))
+	if class == nil || class.DeletionTimestamp != nil {
+		return nil, missing
+	}
+	if class.Spec.ControllerName != constants.ManagedGatewayMeshController {
+		return nil, &WaypointError{Reason: "UnsupportedWaypointClass", Message: fmt.Sprintf("Gateway %q is not an Istio mesh waypoint", waypoint)}
+	}
+	if slices.FindFunc(gateway.Spec.Listeners, func(l gatewayv1.Listener) bool { return !unexpectedWaypointListener(l) }) == nil {
+		return nil, &WaypointError{Reason: "UnsupportedWaypointListener", Message: fmt.Sprintf("Istio waypoint %q requires an HBONE listener on port 15008", waypoint)}
+	}
+	services := ctx.ambientServices.Get(ctx.Krt).Load()
+	if services == nil {
+		return nil, missing
+	}
+	hostname := svc.Name + "." + svc.Namespace + ".svc." + ctx.DomainSuffix
+	info := krt.FetchOne(ctx.Krt, *services, krt.FilterKey(svc.Namespace+"/"+hostname))
+	if info == nil || info.Source.Kind != kind.Service || info.Source.Name != svc.Name || info.Source.Namespace != svc.Namespace {
+		return nil, missing
+	}
+	if info.Waypoint.Error != nil {
+		return nil, &WaypointError{Reason: WaypointErrorReason(info.Waypoint.Error.Reason), Message: info.Waypoint.Error.Message}
+	}
+	waypointRef, usable := model.WaypointReferenceFromGatewayAddress(info.Service.GetWaypoint())
+	if info.Waypoint.ResourceName != waypoint || !usable || (waypointRef.Hostname != "" && waypointRef.Namespace != waypointNamespace) {
+		return nil, missing
+	}
+	vip, err := netip.ParseAddr(svc.Spec.ClusterIP)
+	if err != nil || slices.FindFunc(info.Service.GetAddresses(), func(addr *workloadapi.NetworkAddress) bool {
+		address, ok := netip.AddrFromSlice(addr.GetAddress())
+		return ok && address == vip
+	}) == nil {
+		return nil, missing
+	}
+	return info, nil
+}
