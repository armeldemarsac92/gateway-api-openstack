+		consts.BundleVersionAnnotation: "v1.7.0",
+	})
+	cluster := model.BuildSubsetKey(model.TrafficDirectionInboundVIP, "http", "app.default.svc.cluster.local", 9090)
+	routeConfig := func(listeners []*listenerv3.Listener) *route.VirtualHost {
+		t.Helper()
+		l := xdstest.ExtractListener("main_internal", listeners)
+		chain := xdstest.ExtractFilterChain(cluster, l)
+		if chain == nil {
+			return nil
+		}
+		manager := xdstest.ExtractHTTPConnectionManager(t, chain)
+		assert.Equal(t, manager.GetCodecType(), hcm.HttpConnectionManager_AUTO)
+		assert.Equal(t, manager.GetHttp2ProtocolOptions() != nil, true)
+		return manager.GetRouteConfig().GetVirtualHosts()[0]
+	}
+	routeList := func(action *matcher.Matcher_OnMatch) []*route.Route {
+		t.Helper()
+		list := &route.RouteList{}
+		assert.NoError(t, action.GetAction().GetTypedConfig().UnmarshalTo(list))
+		return list.Routes
+	}
+	waitForNamespaceRoutes := func(want []int) {
+		t.Helper()
+		assert.EventuallyEqual(t, func() []int {
+			push := d.PushContext()
+			proxy.SetSidecarScope(push)
+			vhost := routeConfig(d.ConfigGen.BuildListeners(proxy, push))
+			m := vhost.GetMatcher()
+			fields := m.GetMatcherList().GetMatchers()
+			if len(fields) == 0 {
+				return nil
+			}
+			fallback := routeList(m.GetOnNoMatch())
+			if len(fallback) != 1 || len(fallback[0].GetResponseHeadersToAdd()) != 1 {
+				return nil
+			}
+			counts := make([]int, len(fields))
+			for i, field := range fields {
+				for _, rule := range routeList(field.GetOnMatch()) {
+					if rule.GetMatch().GetGrpc() != nil {
+						counts[i]++
+					}
+				}
+			}
+			return counts
+		}, want)
+	}
+	readLDS := func() *route.VirtualHost {
+		t.Helper()
+		ads := d.ConnectADS().WithType(v3.ListenerType).
+			WithID("waypoint~3.0.0.1~waypoint-pod.default~default.svc.cluster.local").
+			WithMetadata(model.NodeMetadata{Labels: proxy.Labels})
+		defer ads.Cleanup()
+		res := ads.RequestResponseAck(t, nil)
+		return routeConfig(slices.Map(res.Resources, func(a *anypb.Any) *listenerv3.Listener {
+			return xdstest.UnmarshalAny[listenerv3.Listener](t, a)
+		}))
+	}
+	value := func(rule *route.Route) string {
+		t.Helper()
+		headers := rule.GetResponseHeadersToAdd()
+		assert.Equal(t, len(headers), 1)
+		assert.Equal(t, headers[0].GetHeader().GetKey(), "x-route")
+		return headers[0].GetHeader().GetValue()
+	}
+	waitForNamespaceRoutes([]int{0})
+	if !enabled {
+		m := readLDS().GetMatcher()
+		consumer := routeList(m.GetMatcherList().GetMatchers()[0].GetOnMatch())
+		assert.Equal(t, len(consumer), 1)
+		assert.Equal(t, consumer[0].GetMatch().GetGrpc(), nil)
+		assert.Equal(t, value(consumer[0]), "http-consumer")
+		assert.Equal(t, value(routeList(m.GetOnNoMatch())[0]), "producer")
+		return
+	}
+	ctx := context.Background()
+	client := d.KubeClient().GatewayAPI().GatewayV1().GRPCRoutes("shop")
+	target := gatewayv1.BackendObjectReference{
+		Name: "app", Namespace: ptr.Of(gatewayv1.Namespace("default")), Port: ptr.Of(gatewayv1.PortNumber(9090)),
+	}
+	consumer := &gatewayv1.GRPCRoute{
+		ObjectMeta: metav1.ObjectMeta{Name: "app", Namespace: "shop"},
+		Spec: gatewayv1.GRPCRouteSpec{
+			CommonRouteSpec: gatewayv1.CommonRouteSpec{ParentRefs: []gatewayv1.ParentReference{{
+				Group: ptr.Of(gatewayv1.Group("")), Kind: ptr.Of(gatewayv1.Kind("Service")),
+				Name: target.Name, Namespace: target.Namespace, Port: target.Port,
+			}}},
+			Rules: []gatewayv1.GRPCRouteRule{{
+				Matches: []gatewayv1.GRPCRouteMatch{{
+					Method: &gatewayv1.GRPCMethodMatch{Service: ptr.Of("shop.v1.Catalog"), Method: ptr.Of("GetItem")},
+					Headers: []gatewayv1.GRPCHeaderMatch{
+						{Name: "X-Client", Value: "shop"}, {Name: "x-client", Value: "ignored"},
+					},
+				}},
+				Filters: []gatewayv1.GRPCRouteFilter{{
+					Type: gatewayv1.GRPCRouteFilterResponseHeaderModifier,
+					ResponseHeaderModifier: &gatewayv1.HTTPHeaderFilter{
+						Set: []gatewayv1.HTTPHeader{{Name: "x-route", Value: "consumer 100%"}},
+					},
+				}},
+				BackendRefs: []gatewayv1.GRPCBackendRef{{BackendRef: gatewayv1.BackendRef{BackendObjectReference: target}}},
+			}},
+		},
+	}
+	_, err := client.Create(ctx, consumer, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	shopFallback := consumer.DeepCopy()
+	shopFallback.Name = "fallback"
+	shopFallback.Spec.Rules[0].Matches = nil
+	shopFallback.Spec.Rules[0].Filters[0].ResponseHeaderModifier.Set[0].Value = "shop-fallback"
+	_, err = client.Create(ctx, shopFallback, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	warehouse := consumer.DeepCopy()
+	warehouse.Namespace = "warehouse"
+	warehouse.Spec.Rules[0].Matches[0].Headers = nil
+	warehouse.Spec.Rules[0].Filters[0].ResponseHeaderModifier.Set[0].Value = "warehouse"
+	warehouseRoutes := d.KubeClient().GatewayAPI().GatewayV1().GRPCRoutes("warehouse")
+	_, err = warehouseRoutes.Create(ctx, warehouse, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	waitForNamespaceRoutes([]int{2, 1})
+	m := readLDS().GetMatcher()
+	fields := m.GetMatcherList().GetMatchers()
+	assert.Equal(t, len(fields), 2)
+	predicate := fields[0].GetPredicate().GetSinglePredicate()
+	input := &networkinput.FilterStateInput{}
+	assert.NoError(t, predicate.GetInput().GetTypedConfig().UnmarshalTo(input))
+	assert.Equal(t, input.GetKey(), "io.istio.peer_principal")
+	principal := regexp.MustCompile(predicate.GetValueMatch().GetSafeRegex().GetRegex())
+	assert.Equal(t, principal.MatchString("spiffe://cluster.local/ns/shop/sa/client"), true)
+	assert.Equal(t, principal.MatchString("spiffe://equivalent.example/ns/shop/sa/client"), true)
+	assert.Equal(t, principal.MatchString("spiffe://ca-only.example/ns/shop/sa/client"), false)
+	assert.Equal(t, principal.MatchString("spiffe://cluster.local/ns/warehouse/sa/client"), false)
+	assert.Equal(t, principal.MatchString("spiffe://cluster.local/ns/default/sa/client"), false)
+	rules := routeList(fields[0].GetOnMatch())
+	assert.Equal(t, len(rules), 2)
+	match := rules[0].GetMatch()
+	assert.Equal(t, match.GetGrpc() != nil, true)
+	assert.Equal(t, match.GetPath(), "/shop.v1.Catalog/GetItem")
+	assert.Equal(t, len(match.GetHeaders()), 2)
+	assert.Equal(t, match.GetHeaders()[0].GetName(), "x-client")
+	assert.Equal(t, match.GetHeaders()[0].GetStringMatch().GetExact(), "shop")
+	assert.Equal(t, match.GetHeaders()[1].GetName(), ":method")
+	assert.Equal(t, match.GetHeaders()[1].GetStringMatch().GetExact(), "POST")
+	assert.Equal(t, rules[0].GetRoute().GetCluster(), cluster)
+	assert.Equal(t, rules[0].GetRoute().GetHashPolicy()[0].GetHeader().GetHeaderName(), "x-port-affinity")
+	assert.Equal(t, value(rules[0]), "consumer 100%%")
+	assert.Equal(t, value(rules[1]), "shop-fallback")
+	warehousePrincipal := regexp.MustCompile(fields[1].GetPredicate().GetSinglePredicate().GetValueMatch().GetSafeRegex().GetRegex())
+	assert.Equal(t, warehousePrincipal.MatchString("spiffe://cluster.local/ns/warehouse/sa/client"), true)
+	assert.Equal(t, warehousePrincipal.MatchString("spiffe://cluster.local/ns/shop/sa/client"), false)
+	assert.Equal(t, warehousePrincipal.MatchString("spiffe://cluster.local/ns/default/sa/client"), false)
+	assert.Equal(t, value(routeList(fields[1].GetOnMatch())[0]), "warehouse")
+	assert.Equal(t, value(routeList(m.GetOnNoMatch())[0]), "producer")
+
+	gateways := d.KubeClient().GatewayAPI().GatewayV1().Gateways("default")
+	wp, err := gateways.Get(ctx, "waypoint", metav1.GetOptions{})
+	assert.NoError(t, err)
+	wp.Labels = map[string]string{label.IoIstioWaypointFor.Name: constants.WorkloadTraffic}
+	wp, err = gateways.Update(ctx, wp, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	assert.EventuallyEqual(t, func() bool {
+		push := d.PushContext()
+		proxy.SetSidecarScope(push)
+		return routeConfig(d.ConfigGen.BuildListeners(proxy, push)) == nil
+	}, true)
+	assert.Equal(t, readLDS(), nil)
+	assert.EventuallyEqual(t, func() int {
+		return len(d.PushContext().VirtualServicesForGateway("default", constants.IstioAmbientConsumerGRPCGateway))
+	}, 0)
+	wp.Labels[label.IoIstioWaypointFor.Name] = constants.ServiceTraffic
+	_, err = gateways.Update(ctx, wp, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	waitForNamespaceRoutes([]int{2, 1})
+	m = readLDS().GetMatcher()
+	assert.Equal(t, value(routeList(m.GetMatcherList().GetMatchers()[0].GetOnMatch())[0]), "consumer 100%%")
+
+	assert.NoError(t, client.Delete(ctx, consumer.Name, metav1.DeleteOptions{}))
+	assert.NoError(t, client.Delete(ctx, shopFallback.Name, metav1.DeleteOptions{}))
+	assert.NoError(t, warehouseRoutes.Delete(ctx, warehouse.Name, metav1.DeleteOptions{}))
+	waitForNamespaceRoutes([]int{0})
+	m = readLDS().GetMatcher()
+	assert.Equal(t, value(routeList(m.GetMatcherList().GetMatchers()[0].GetOnMatch())[0]), "http-consumer")
+	assert.Equal(t, value(routeList(m.GetOnNoMatch())[0]), "producer")
+}
