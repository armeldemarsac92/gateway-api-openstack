index 0000000000000000000000000000000000000000..6fa8f1ebf952e6f0f61bacb66130486033027512
--- /dev/null
+++ b/magnum_capi_helm/gateway_api.py
@@ -0,0 +1,334 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+import base64
+from enum import Enum
+import hashlib
+from pathlib import Path
+import re
+from tempfile import TemporaryDirectory
+from uuid import UUID
+
+from magnum.common import exception
+from magnum.objects import fields
+import yaml
+
+from magnum_capi_helm import conf
+from magnum_capi_helm import driver_utils
+
+CONF = conf.CONF
+ADDON = "openstack-gw"
+NAMESPACE = "openstack-gateway-system"
+CONTROLLER = "gateway-api-openstack.github.io/magnum-gateway"
+ARCHIVE = "openstack-cluster-0.10.1.tgz"
+CHART_DIGEST = (
+    "fa3c30070e6f9f6684bfb10641917089b5d8453d91bc566230544029a0380d9d"
+)
+MANIFEST = "gateway-controller.yaml"
+CLEANUP_EVIDENCE = "gateway-api-openstack.github.io/cleanup-evidence"
+OWNER_LABEL = "gateway-api-openstack.github.io/cluster-uuid"
+ENROLLMENT_ANNOTATION = "gateway-api-openstack.github.io/enrolled-cluster"
+CREDENTIAL_REFERENCE = f"{NAMESPACE}/openstack-clouds"
+WORKLOAD_OBJECTS = {
+    (
+        "v1",
+        "ConfigMap",
+        "magnum-openstack-gateway-controller-config",
+        NAMESPACE,
+    ),
+    ("v1", "ServiceAccount", "magnum-openstack-gateway-controller", NAMESPACE),
+    (
+        "apps/v1",
+        "Deployment",
+        "magnum-openstack-gateway-controller",
+        NAMESPACE,
+    ),
+    (
+        "rbac.authorization.k8s.io/v1",
+        "ClusterRole",
+        "magnum-openstack-gateway-controller",
+        None,
+    ),
+    (
+        "rbac.authorization.k8s.io/v1",
+        "ClusterRoleBinding",
+        "magnum-openstack-gateway-controller",
+        None,
+    ),
+}
+
+
+class State(Enum):
+    ACTIVE = "active"
+    DRAINED = "drained"
+
+
+def selected(template_id):
+    return template_id in CONF.capi_helm.gateway_api_cluster_templates
+
+
+def _cluster_identity(cluster):
+    try:
+        if str(UUID(cluster.uuid)) == cluster.uuid:
+            return cluster.uuid
+    except (AttributeError, TypeError, ValueError):
+        pass
+    raise exception.MagnumException(
+        message="Gateway addon requires a canonical Magnum cluster UUID."
+    )
+
+
+def _record_names(cluster):
+    identity = _cluster_identity(cluster)
+    return f"gateway-enrollment-{identity}", f"gateway-addon-{identity}"
+
+
+def _marker_data(cluster):
+    return {
+        "cluster-uuid": base64.b64encode(
+            _cluster_identity(cluster).encode()
+        ).decode(),
+        "credential-reference": base64.b64encode(
+            CREDENTIAL_REFERENCE.encode()
+        ).decode(),
+    }
+
+
+def _validated_record(record, cluster):
+    metadata = record.get("metadata", {})
+    if (
+        record.get("immutable") is not True
+        or record.get("data") != _marker_data(cluster)
+        or metadata.get("labels", {}).get(OWNER_LABEL) != cluster.uuid
+        or metadata.get("deletionTimestamp") is not None
+    ):
+        raise exception.MagnumException(
+            message="Invalid Gateway addon enrollment record or marker."
+        )
+    return metadata
+
+
+def state(client, cluster):
+    namespace = driver_utils.cluster_namespace(cluster)
+    enrollment_name, marker_name = _record_names(cluster)
+    enrollment = client.get_secret(enrollment_name, namespace)
+    marker = client.get_secret(marker_name, namespace)
+    if enrollment is None and marker is None:
+        # The installed CAPI Cluster retains an independent enrollment clue if
+        # both records are accidentally removed from the management namespace.
+        release = driver_utils.chart_release_name(cluster)
+        capi = client.get_capi_cluster(release, namespace) if release else None
+        if ENROLLMENT_ANNOTATION not in (capi or {}).get("metadata", {}).get(
+            "annotations", {}
+        ):
+            return None
+    if enrollment is None or marker is None:
+        raise exception.MagnumException(
+            message="Gateway addon enrollment record or marker is missing. "
+            "Recover the cluster's enrollment records before continuing."
+        )
+    _validated_record(enrollment, cluster)
+    metadata = _validated_record(marker, cluster)
+    evidence = metadata.get("annotations", {}).get(CLEANUP_EVIDENCE, "")
+    if not evidence:
+        return State.ACTIVE
+    if not re.fullmatch(r"sha256:[a-f0-9]{64}", evidence):
+        raise exception.MagnumException(
+            message="Invalid Gateway addon teardown evidence digest."
+        )
+    return State.DRAINED
+
+
+def register(client, cluster):
+    # This is called before the release name is saved or any provider resources
+    # can be created. In this phase a retry may complete a partial registration.
+    namespace = driver_utils.cluster_namespace(cluster)
+    body = {
+        "metadata": {"labels": {OWNER_LABEL: cluster.uuid}},
+        "immutable": True,
+        "data": _marker_data(cluster),
+    }
+    enrollment, marker = _record_names(cluster)
+    for name in (enrollment, marker):
+        existing = client.get_secret(name, namespace)
+        if existing is not None:
+            _validated_record(existing, cluster)
+        else:
+            client.apply_secret(name, body, namespace)
+
+
+def needs_drain_check(cluster):
+    # A partial registration can be cleaned up once CREATE_FAILED is
+    # recorded. The driver saves its release name before provider writes.
+    return bool(driver_utils.chart_release_name(cluster)) or (
+        cluster.status
+        not in {
+            fields.ClusterStatus.CREATE_FAILED,
+            fields.ClusterStatus.DELETE_IN_PROGRESS,
+        }
+    )
+
+
+def require_drained(current, cluster):
+    # A rejected delete while create runs makes Magnum set DELETE_FAILED.
+    if (
+        current is not State.DRAINED
+        and not driver_utils.chart_release_name(cluster)
+        and cluster.status
+        in {
+            fields.ClusterStatus.CREATE_IN_PROGRESS,
+            fields.ClusterStatus.DELETE_FAILED,
+        }
+        and selected(cluster.cluster_template_id)
+    ):
+        raise exception.MagnumException(
+            message="Wait for Gateway addon create to finish before deleting this cluster."
+        )
+    if current is State.ACTIVE:
+        raise exception.MagnumException(
+            message="Gateway addon teardown requires a verified allocation fence, "
+            "an empty cluster-owned cloud inventory and an operator acknowledgement."
+        )
+
+
+def _read_pinned(directory, filename, digest):
+    if not re.fullmatch(r"[a-f0-9]{64}", digest):
+        raise exception.MagnumException(
+            message=f"Gateway addon requires a SHA-256 digest for {filename}."
+        )
+    try:
+        data = (directory / filename).read_bytes()
+    except OSError:
+        raise exception.MagnumException(
+            message=f"Cannot read Gateway addon artifact {filename}."
+        ) from None
+    if hashlib.sha256(data).hexdigest() != digest:
+        raise exception.MagnumException(
+            message=f"Gateway addon digest mismatch for {filename}."
+        )
+    return data
+
+
+def _workload_manifest(directory, cluster):
+    manifest = _read_pinned(
+        directory, MANIFEST, CONF.capi_helm.gateway_api_manifest_sha256
+    )
+    image = CONF.capi_helm.gateway_api_controller_image
+    if not re.fullmatch(
+        r"[a-z0-9][a-z0-9.:-]*/[a-z0-9._/-]+@sha256:[a-f0-9]{64}", image
+    ):
+        raise exception.MagnumException(
+            message="Gateway controller image must be a repository pinned by SHA-256."
+        )
+    try:
+        manifest = manifest.decode("utf-8")
+        if (
+            manifest.count("controller:latest") != 1
+            or manifest.count("replace-with-stable-cluster-id") != 1
+        ):
+            raise ValueError("unexpected placeholders")
+        manifest = manifest.replace("controller:latest", image).replace(
+            "replace-with-stable-cluster-id", _cluster_identity(cluster)
+        )
+        resources = list(yaml.safe_load_all(manifest))
+        identities = {
+            (
+                resource["apiVersion"],
+                resource["kind"],
+                resource["metadata"]["name"],
+                resource["metadata"].get("namespace"),
+            )
+            for resource in resources
+        }
+        if (
+            len(resources) != len(WORKLOAD_OBJECTS)
+            or identities != WORKLOAD_OBJECTS
+        ):
+            raise ValueError("unexpected workload objects")
+        config = next(
+            obj["data"] for obj in resources if obj["kind"] == "ConfigMap"
+        )
+        pod = next(
+            obj["spec"]["template"]["spec"]
+            for obj in resources
+            if obj["kind"] == "Deployment"
+        )
+        if (
+            config["GATEWAY_OPENSTACK_CONTROLLER_NAME"] != CONTROLLER
+            or config["GATEWAY_OPENSTACK_CLUSTER_ID"] != cluster.uuid
+            or len(pod["containers"]) != 1
+            or pod["containers"][0]["image"] != image
+            or not any(
+                volume.get("secret", {}).get("secretName")
+                == "openstack-clouds"
+                for volume in pod["volumes"]
+            )
+        ):
+            raise ValueError("unexpected controller or credential reference")
+    except (AttributeError, KeyError, TypeError, ValueError, yaml.YAMLError):
+        raise exception.MagnumException(
+            message="Invalid Gateway addon workload manifest."
+        ) from None
+    return manifest
+
+
+def validate_chart(chart_version):
+    if (
+        CONF.capi_helm.helm_chart_name != "openstack-cluster"
+        or chart_version != "0.10.1"
+    ):
+        raise exception.MagnumException(
+            message="Gateway addon requires the pinned openstack-cluster 0.10.1 chart."
+        )
+
+
+def install(helm_client, cluster, values, chart_version):
+    validate_chart(chart_version)
+    if not CONF.capi_helm.gateway_api_artifacts_dir:
+        raise exception.MagnumException(
+            message="Gateway addon requires a pinned local artifact directory."
+        )
+    directory = Path(CONF.capi_helm.gateway_api_artifacts_dir)
+    chart = _read_pinned(directory, ARCHIVE, CHART_DIGEST)
+    manifest = _workload_manifest(directory, cluster)
+    values["addons"]["custom"] = {
+        ADDON: {
+            "kind": "Manifests",
+            "spec": {
+                "namespace": NAMESPACE,
+                "manifests": {MANIFEST: manifest},
+            },
+        }
+    }
+    values.setdefault("clusterAnnotations", {})[
+        ENROLLMENT_ANNOTATION
+    ] = cluster.uuid
+    # Helm consumes a private copy of the bytes checked above and never fetches a mutable repo entry.
+    with TemporaryDirectory(prefix="magnum-gateway-") as workdir:
+        archive = Path(workdir) / ARCHIVE
+        archive.write_bytes(chart)
+        helm_client.install_or_upgrade(
+            driver_utils.chart_release_name(cluster),
+            str(archive),
+            values,
+            namespace=driver_utils.cluster_namespace(cluster),
+        )
+
+
+def addon_present(cluster, addons):
+    name = driver_utils.chart_release_name(cluster)
+    return any(
+        addon["metadata"]["name"] == f"{name}-{ADDON}"
+        and addon.get("spec", {}).get("clusterName") == name
+        and addon["spec"].get("targetNamespace") == NAMESPACE
+        and addon["spec"].get("releaseName") == ADDON
+        for addon in addons
+    )
