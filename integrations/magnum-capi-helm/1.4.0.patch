+    def test_offline_render_uses_pinned_parent_and_workload_objects(self):
+        helm = os.environ.get("MAGNUM_TEST_HELM")
+        directory = os.environ.get("MAGNUM_TEST_ARTIFACTS")
+        if not helm or not directory:
+            self.skipTest("Set MAGNUM_TEST_HELM and MAGNUM_TEST_ARTIFACTS")
+        directory = Path(directory)
+        archive = directory / "openstack-cluster-0.10.1.tgz"
+        manifest = directory / "gateway-controller.yaml"
+        self._options(
+            gateway_api_artifacts_dir=str(directory),
+            gateway_api_manifest_sha256=hashlib.sha256(
+                manifest.read_bytes()
+            ).hexdigest(),
+            gateway_api_controller_image="registry.example.test/gateway/controller@sha256:"
+            + "b" * 64,
+        )
+        self.cluster.cluster_template.labels["capi_helm_chart_version"] = (
+            "0.10.1"
+        )
+
+        def render(command, *, process_input):
+            self.assertEqual("upgrade", command[0])
+            mode = "off" if command[2] == "openstack-cluster" else "on"
+            if mode == "on":
+                self.assertEqual(
+                    archive.read_bytes(), Path(command[2]).read_bytes()
+                )
+                self.assertNotIn("--repo", command)
+            manifest_path = directory / f"render-{mode}.yaml"
+            manifest_path.write_bytes(
+                subprocess.run(
+                    [
+                        helm,
+                        "template",
+                        command[1],
+                        str(archive),
+                        "--namespace",
+                        "magnum-project22",
+                        "--values",
+                        "-",
+                    ],
+                    input=process_input.encode(),
+                    check=True,
+                    capture_output=True,
+                ).stdout
+            )
+            return "{}"
+
+        self.driver._helm_client._run.side_effect = render
+        self._update()
+        marker = self._register()
+        self._options(gateway_api_cluster_templates=[])
+        self._update()
+        off = list(
+            yaml.safe_load_all((directory / "render-off.yaml").read_text())
+        )
+        on = list(
+            yaml.safe_load_all((directory / "render-on.yaml").read_text())
+        )
+        self.assertFalse(
+            any(
+                obj.get("spec", {}).get("releaseName") == "openstack-gw"
+                for obj in off
+                if obj
+            )
+        )
+        addon = next(
+            obj
+            for obj in on
+            if obj
+            and obj["kind"] == "Manifests"
+            and obj["spec"]["releaseName"] == "openstack-gw"
+        )
+        self.assertEqual(self.cluster.stack_id, addon["spec"]["clusterName"])
+        capi = next(obj for obj in on if obj and obj["kind"] == "Cluster")
+        self.assertEqual(
+            self.cluster.uuid,
+            capi["metadata"]["annotations"][gateway_api.ENROLLMENT_ANNOTATION],
+        )
+        self.assertEqual(
+            "openstack-gateway-system", addon["spec"]["targetNamespace"]
+        )
+        self.assertTrue(addon["spec"]["bootstrap"])
+        source = next(
+            obj
+            for obj in on
+            if obj
+            and obj["kind"] == "Secret"
+            and obj["metadata"]["name"]
+            == addon["spec"]["manifestSources"][0]["secret"]["name"]
+        )
+        entry = source["stringData"]["gateway-controller.yaml"].strip()
+        self.assertTrue(entry.startswith("{%- raw %}"))
+        self.assertTrue(entry.endswith("{%- endraw %}"))
+        resources = list(
+            yaml.safe_load_all(
+                entry.removeprefix("{%- raw %}").removesuffix("{%- endraw %}")
+            )
+        )
+        self.assertEqual(
+            {
+                "ConfigMap",
+                "ServiceAccount",
+                "ClusterRole",
+                "ClusterRoleBinding",
+                "Deployment",
+            },
+            {resource["kind"] for resource in resources},
+        )
+        deployment = next(
+            resource
+            for resource in resources
+            if resource["kind"] == "Deployment"
+        )
+        self.assertEqual(
+            "openstack-gateway-system", deployment["metadata"]["namespace"]
+        )
+        pod = deployment["spec"]["template"]["spec"]
+        self.assertEqual(
+            conf.CONF.capi_helm.gateway_api_controller_image,
+            pod["containers"][0]["image"],
+        )
+        volume = next(
+            volume
+            for volume in pod["volumes"]
+            if volume.get("secret", {}).get("secretName") == "openstack-clouds"
+        )
+        mount = next(
+            mount
+            for mount in pod["containers"][0]["volumeMounts"]
+            if mount["name"] == volume["name"]
+        )
+        self.assertEqual("/etc/openstack", mount["mountPath"])
+        self.assertNotIn("items", volume["secret"])
+        self.assertNotIn("subPath", mount)
+        self.assertNotIn("subPathExpr", mount)
+        binding = next(
+            resource
+            for resource in resources
+            if resource["kind"] == "ClusterRoleBinding"
+        )
+        self.assertEqual(
+            pod["serviceAccountName"], binding["subjects"][0]["name"]
+        )
+        self.assertEqual(
+            "openstack-gateway-system", binding["subjects"][0]["namespace"]
+        )
+        data = next(
+            resource["data"]
+            for resource in resources
+            if resource["kind"] == "ConfigMap"
+        )
+        self.assertEqual(
+            self.cluster.uuid, data["GATEWAY_OPENSTACK_CLUSTER_ID"]
+        )
+
+        self._options(gateway_api_manifest_sha256="0" * 64)
+        self.assertRaisesRegex(
+            exception.MagnumException, "digest", self._update
+        )
+        marker["metadata"].setdefault("annotations", {})[
+            "gateway-api-openstack.github.io/cleanup-evidence"
+        ] = ("sha256:" + "a" * 64)
+        self._update()
+        self.assertNotIn(
+            "openstack-gw", (directory / "render-off.yaml").read_text()
+        )
