  "requests": [
    {
      "case": "prefix apex with query",
      "request_target": "/legacy?q=One",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test:8443/legacy?q=One"
      }
    },
    {
      "case": "prefix with slash",
      "request_target": "/legacy/",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test:8443/legacy/"
      }
    },
    {
      "case": "mixed case and percent encoding in path and query",
      "request_target": "/legacy/Ab%2fCd%3F?q=%2f+One&Q=%2B&q=Second",
      "host": "different.source.example.test:9010",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test:8443/legacy/Ab%2fCd%3F?q=%2f+One&Q=%2B&q=Second"
      }
    },
    {
      "case": "Exact uses path independent of query and Host port",
      "request_target": "/permanent?x=%2F",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 301,
        "location": "https://moved.example.test:8443/permanent?x=%2F"
      }
    },
    {
      "case": "Exact trailing slash falls through",
      "request_target": "/permanent/",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 200,
        "location": null,
        "echo": "sibling /permanent/"
      }
    },
    {
      "case": "different Host falls through",
      "request_target": "/permanent",
      "host": "unmatched.example.test",
      "observed": {
        "status": 200,
        "location": null,
        "echo": "sibling /permanent"
      }
    },
    {
      "case": "PathPrefix requires a segment boundary",
      "request_target": "/legacyish?x=%2F",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 200,
        "location": null,
        "echo": "sibling /legacyish?x=%2F"
      }
    },
    {
      "case": "PathPrefix is case sensitive",
      "request_target": "/Legacy/Ab",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 200,
        "location": null,
        "echo": "sibling /Legacy/Ab"
      }
    },
    {
      "case": "URL action loses the query even on Exact",
      "request_target": "/literal?x=one",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test:8443/literal"
      },
      "gateway_expected": {
        "status": 302,
        "location": "https://moved.example.test:8443/literal?x=one"
      }
    },
    {
      "case": "known scheme supplies omitted default port",
      "request_target": "/default-port",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test/default-port"
      }
    },
    {
      "case": "listener supplies omitted scheme and port",
      "request_target": "/hostname-redirect",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "http://example.org:58175/hostname-redirect"
      }
    },
    {
      "case": "frontend redirect preempts earlier Exact forwarding",
      "request_target": "/legacy/stay",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 302,
        "location": "https://moved.example.test:8443/legacy/stay"
      },
      "gateway_expected": {
        "status": 200,
        "location": null,
        "echo": "sibling /legacy/stay"
      }
    },
    {
      "case": "earlier Exact forwarding with both overlapping policies disabled",
      "request_target": "/legacy/stay",
      "host": "MiXeD.source.example.test:9123",
      "observed": {
        "status": 200,
        "location": null,
        "echo": "sibling /legacy/stay"
      }
    }
  ],
  "listener_port": 58175,
  "amphora_frontend_rules": [
    "acl <higher-exact-forwarding:PATH> path -m str /legacy/stay",
    "use_backend <echo-pool>:<http-listener> if <higher-exact-forwarding:PATH>",
    "acl <redirect-prefix-apex:PATH> path -m str /legacy",
    "redirect code 302 prefix https://moved.example.test:8443 if <redirect-prefix-apex:PATH>",
    "acl <redirect-prefix-children:PATH> path -m beg /legacy/",
    "redirect code 302 prefix https://moved.example.test:8443 if <redirect-prefix-children:PATH>",
    "acl <redirect-exact-301:PATH> path -m str /permanent",
    "acl <redirect-exact-301:HOST_NAME> req.hdr(host) -i -m reg ^mixed\\\\.source\\\\.example\\\\.test(:[0-9]+)?$",
    "redirect code 301 prefix https://moved.example.test:8443 if <redirect-exact-301:PATH> <redirect-exact-301:HOST_NAME>",
    "acl <literal-location:PATH> path -m str /literal",
    "redirect code 302 location https://moved.example.test:8443/literal if <literal-location:PATH>",
    "acl <scheme-default-port:PATH> path -m str /default-port",
    "redirect code 302 prefix https://moved.example.test if <scheme-default-port:PATH>",
    "acl <listener-scheme-and-port:PATH> path -m str /hostname-redirect",
    "redirect code 302 prefix http://example.org:58175 if <listener-scheme-and-port:PATH>",
    "acl <sibling-catchall:PATH> path -m beg /",
    "use_backend <echo-pool>:<http-listener> if <sibling-catchall:PATH>"
  ],
  "probe_passed": true
}
