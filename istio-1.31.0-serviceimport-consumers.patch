+
+// ServiceUsesOnlyPrimaryWaypoint reports whether every active destination is the primary
+// waypoint. A weighted list with no active destination cannot serve consumer routes.
+func ServiceUsesOnlyPrimaryWaypoint(service *workloadapi.Service) bool {
+	primary := service.GetWaypoint()
+	if primary == nil {
+		return false
+	}
+	weighted := service.GetWeightedWaypoints()
+	if len(weighted) == 0 {
+		return true
+	}
+	primaryReceivesTraffic := false
+	for _, waypoint := range weighted {
+		if waypoint.GetWeight() == 0 {
+			continue
+		}
+		if !proto.Equal(waypoint.GetDestination(), primary) {
+			return false
+		}
+		primaryReceivesTraffic = true
+	}
+	return primaryReceivesTraffic
+}
