+import (
+	"testing"
+
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+
+	"istio.io/istio/pkg/test/util/assert"
+)
+
+func TestReadMCSImportRejectsUnsupportedTraffic(t *testing.T) {
+	imported := &unstructured.Unstructured{Object: map[string]any{
+		"apiVersion": MCSServiceImportGroup + "/v1beta1",
+		"kind":       MCSServiceImportKind,
+		"metadata": map[string]any{
+			"namespace": "default", "name": "store", "uid": "import-1",
+			"labels":      map[string]any{"istio.io/use-waypoint": "waypoint"},
+			"annotations": map[string]any{MCSProviderAnnotation: "mcs.example.io"},
+		},
+		"spec": map[string]any{
+			"type": "ClusterSetIP", "ips": []any{"1.2.3.4"},
+			"ports": []any{map[string]any{"port": int64(80), "name": "web", "appProtocol": "http"}},
+		},
+		"status": map[string]any{"endpointSliceObjects": "Present"},
+	}}
+	_, err := ReadMCSImport(imported)
+	assert.NoError(t, err)
+
+	for _, tc := range []struct {
+		name  string
+		field string
+		value any
+	}{
+		{"local endpoint policy", "internalTrafficPolicy", "Local"},
+		{"inconsistent IP families", "ipFamilies", []any{"IPv6"}},
+		{"non-HTTP protocol", "ports", []any{map[string]any{"port": int64(80), "name": "web", "appProtocol": "https"}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			input := imported.DeepCopy()
+			assert.NoError(t, unstructured.SetNestedField(input.Object, tc.value, "spec", tc.field))
+			_, err := ReadMCSImport(input)
+			if err == nil {
+				t.Fatalf("unsupported input was accepted")
+			}
+		})
+	}
+}
