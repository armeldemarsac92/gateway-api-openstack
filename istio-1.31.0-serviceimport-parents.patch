 }
+
+const (
+	MCSServiceImportGroup = "multicluster.x-k8s.io"
+	MCSServiceImportKind  = "ServiceImport"
+	MCSProjectorLabel     = "gateway-api-openstack.github.io/managed-by"
+	MCSProjectorName      = "hibiscus-mcs-projector"
+)
+
+// MeshServiceImport identifies the projection eligible to receive an imported VIP's routes.
+type MeshServiceImport struct {
+	Namespace  string
+	Projection string
+	ImportUID  string
+	VIP        string
+	Waypoint   string
+	Port       uint32
+}
+
+func MCSProjectionName(importName string) string {
+	digest := sha256.Sum256([]byte(importName))
+	return fmt.Sprintf("hibiscus-mcs-%x", digest[:16])
+}
+
+func MCSProjectionOwner(meta metav1.ObjectMeta) *metav1.OwnerReference {
+	if meta.Labels[MCSProjectorLabel] != MCSProjectorName || len(meta.OwnerReferences) != 1 {
+		return nil
+	}
+	owner := &meta.OwnerReferences[0]
+	if owner.Kind != MCSServiceImportKind || owner.UID == "" || owner.Controller == nil || !*owner.Controller ||
+		(owner.APIVersion != MCSServiceImportGroup+"/v1beta1" && owner.APIVersion != MCSServiceImportGroup+"/v1alpha1") ||
+		meta.Name != MCSProjectionName(owner.Name) {
+		return nil
+	}
+	return owner
+}
