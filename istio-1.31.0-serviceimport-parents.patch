+var mcsServiceImportGVK = config.GroupVersionKind{
+	Group: configgateway.MCSServiceImportGroup, Kind: configgateway.MCSServiceImportKind,
+}
+
+func (ctx RouteContext) serviceImportBinding(namespace, name string) (*configgateway.MCSImport, *ParentError, *WaypointError) {
+	fail := func(reason ParentErrorReason, message string) (*configgateway.MCSImport, *ParentError, *WaypointError) {
+		return nil, &ParentError{Reason: reason, Message: message},
+			&WaypointError{Reason: WaypointErrorReason(reason), Message: message}
+	}
+	key := namespace + "/" + name
+	imported := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.serviceImports.imports, krt.FilterKey(key)))
+	if imported == nil || imported.GetDeletionTimestamp() != nil {
+		return fail(ParentErrorNotAccepted, fmt.Sprintf("ServiceImport %q not found", key))
+	}
+	binding, err := configgateway.ReadMCSImport(imported)
+	if err != nil {
+		return fail(ParentErrorUnsupportedValue, err.Error())
+	}
+	projection := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.ServiceEntries, krt.FilterKey(namespace+"/"+binding.Projection)))
+	if projection == nil || !binding.MatchesProjection(projection.ObjectMeta, &projection.Spec) {
+		return fail(ParentErrorNotAccepted, fmt.Sprintf("ServiceImport %q does not have a matching managed ServiceEntry", key))
+	}
+
+	// The service view is the one actually used to publish WDS. It includes the
+	// ready waypoint and its ownership, visibility and allowedRoutes checks.
+	services := ctx.serviceImports.ambientServices.Get(ctx.Krt).Load()
+	if services == nil {
+		return fail(ParentErrorNotAccepted, "Ambient service discovery is unavailable")
+	}
+	info := krt.FetchOne(ctx.Krt, *services, krt.FilterKey(namespace+"/"+binding.Host))
+	if !info.MatchesMCSProjection(binding.MeshServiceImport) {
+		if info != nil && info.MCSImportUID == binding.ImportUID && info.Waypoint.Error != nil {
+			return fail(ParentErrorNotAccepted, info.Waypoint.Error.Message)
+		}
+		return fail(ParentErrorNotAccepted, fmt.Sprintf("ServiceImport %q is not attached to its Istio service waypoint %q", key, binding.Waypoint))
+	}
+	return binding, nil, nil
+}
+
+func resolveServiceImportParent(ctx RouteContext, ref k8s.ParentReference, namespace string) routeParentReference {
+	parent := routeParentReference{
+		InternalName:      "mesh",
+		InternalKind:      mcsServiceImportGVK,
+		OriginalReference: ref,
+		ParentKey:         parentKey{Kind: mcsServiceImportGVK, Name: string(ref.Name), Namespace: defaultString(ref.Namespace, namespace)},
+	}
+	if parent.ParentKey.Namespace != namespace {
+		parent.DeniedReason = &ParentError{Reason: ParentErrorNotAllowed, Message: "ServiceImport parents must be in the HTTPRoute namespace"}
+		parent.WaypointError = &WaypointError{Reason: WaypointErrorReason(ParentErrorNotAllowed), Message: parent.DeniedReason.Message}
+		return parent
+	}
+	binding, denied, waypointError := ctx.serviceImportBinding(namespace, string(ref.Name))
+	parent.DeniedReason, parent.WaypointError = denied, waypointError
+	if binding == nil {
+		return parent
+	}
+	if (ref.Port != nil && uint32(*ref.Port) != binding.Port) ||
+		(ref.SectionName != nil && string(*ref.SectionName) != binding.PortName) {
+		parent.DeniedReason = &ParentError{Reason: ParentErrorNotAccepted, Message: "ServiceImport parent port or sectionName does not match"}
+		return parent
+	}
+	if ctx.meshConfig != nil {
+		mesh := krt.FetchOne(ctx.Krt, ctx.meshConfig.AsCollection())
+		waypointNamespace, _, _ := strings.Cut(binding.Waypoint, "/")
+		if mesh != nil && !configgateway.MCSExportVisible(mesh.GetDefaultVirtualServiceExportTo(), namespace, waypointNamespace) {
+			message := "The route exportTo policy does not permit its waypoint namespace"
+			parent.DeniedReason = &ParentError{Reason: ParentErrorNotAllowed, Message: message}
+			parent.WaypointError = &WaypointError{Reason: "WaypointCannotSeeHTTPRoute", Message: message}
+			return parent
+		}
+	}
+	parent.Hostname = binding.Host
+	parent.ServiceImport = &binding.MeshServiceImport
+	return parent
+}
+
+func serviceImportDestination(ctx RouteContext, namespace, name string, port *k8s.PortNumber) (*istio.Destination, *inferencePoolConfig, *ConfigError) {
+	binding, denied, _ := ctx.serviceImportBinding(namespace, name)
+	if binding == nil {
+		return &istio.Destination{}, nil, &ConfigError{Reason: InvalidDestinationNotFound, Message: denied.Message}
+	}
+	if port == nil || uint32(*port) != binding.Port {
+		return &istio.Destination{}, nil, &ConfigError{Reason: InvalidDestinationNotFound, Message: "ServiceImport backend port does not match"}
+	}
+	return &istio.Destination{Host: binding.Host, Port: &istio.PortSelector{Number: binding.Port}}, nil, nil
+}
