+package kube
+
+import (
+	"cmp"
+	"fmt"
+	"net/netip"
+	"slices"
+	"strings"
+
+	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/util/validation"
+
+	"istio.io/api/label"
+	istio "istio.io/api/networking/v1alpha3"
+	"istio.io/istio/pkg/kube/krt"
+)
+
+const MCSProviderAnnotation = "gateway-api-openstack.github.io/mcs-endpoint-slice-managed-by"
+
+// MCSImport is the supported, enrolled subset of the provider's ServiceImport.
+type MCSImport struct {
+	MeshServiceImport
+	Host       string
+	PortName   string
+	apiVersion string
+	name       string
+	provider   string
+}
+
+func ReadMCSImport(imported *unstructured.Unstructured) (*MCSImport, error) {
+	if imported == nil || imported.GetDeletionTimestamp() != nil || imported.GetUID() == "" {
+		return nil, fmt.Errorf("ServiceImport not found")
+	}
+	enrollment := imported.GetLabels()
+	waypointName := enrollment[label.IoIstioUseWaypoint.Name]
+	waypointNS := cmp.Or(enrollment[label.IoIstioUseWaypointNamespace.Name], imported.GetNamespace())
+	provider := imported.GetAnnotations()[MCSProviderAnnotation]
+	if strings.EqualFold(waypointName, "none") || len(validation.IsDNS1123Subdomain(waypointName)) != 0 ||
+		len(validation.IsDNS1123Label(waypointNS)) != 0 || provider == "" ||
+		provider == "endpointslice-controller.k8s.io" || provider == "endpointslicemirroring-controller.k8s.io" ||
+		len(validation.IsValidLabelValue(provider)) != 0 {
+		return nil, fmt.Errorf("ServiceImport requires explicit waypoint and EndpointSlice provider enrollment")
+	}
+	inventory, _, _ := unstructured.NestedString(imported.Object, "status", "endpointSliceObjects")
+
+	status, _, _ := unstructured.NestedMap(imported.Object, "status")
+	var readiness struct {
+		Conditions []metav1.Condition `json:"conditions"`
+	}
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(status, &readiness); err != nil {
+		return nil, fmt.Errorf("ServiceImport status is invalid")
+	}
+	if ready := meta.FindStatusCondition(readiness.Conditions, "Ready"); ready != nil &&
+		(ready.ObservedGeneration == 0 || ready.ObservedGeneration == imported.GetGeneration()) &&
+		ready.Status != metav1.ConditionTrue {
+		return nil, fmt.Errorf("ServiceImport provider reports that the import is not ready")
+	}
+	data, _, _ := unstructured.NestedMap(imported.Object, "spec")
+	var spec struct {
+		Type                  string   `json:"type"`
+		IPs                   []string `json:"ips"`
+		IPFamilies            []string `json:"ipFamilies"`
+		InternalTrafficPolicy string   `json:"internalTrafficPolicy"`
+		Ports                 []struct {
+			Name        string  `json:"name"`
+			Protocol    string  `json:"protocol"`
+			AppProtocol *string `json:"appProtocol"`
+			Port        int32   `json:"port"`
+		} `json:"ports"`
+	}
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(data, &spec); err != nil ||
+		spec.Type != "ClusterSetIP" || len(spec.IPs) != 1 || len(spec.Ports) != 1 || inventory != "Present" {
+		return nil, fmt.Errorf("ServiceImport requires one ClusterSetIP, one port and a present EndpointSlice inventory")
+	}
+	if spec.InternalTrafficPolicy != "" && spec.InternalTrafficPolicy != "Cluster" {
+		return nil, fmt.Errorf("ServiceImport requires Cluster traffic policy")
+	}
+	ip, err := netip.ParseAddr(spec.IPs[0])
+	port := spec.Ports[0]
+	if err != nil || !ip.Is4() || !ip.IsGlobalUnicast() || ip.IsLoopback() || ip.IsLinkLocalUnicast() ||
+		(len(spec.IPFamilies) != 0 && (len(spec.IPFamilies) != 1 || spec.IPFamilies[0] != "IPv4")) ||
+		port.Port < 1 || port.Port > 65535 || (port.Protocol != "" && port.Protocol != "TCP") {
+		return nil, fmt.Errorf("ServiceImport requires an IPv4 VIP and a TCP port")
+	}
+
+	appProtocol := ""
+	if port.AppProtocol != nil {
+		appProtocol = *port.AppProtocol
+	}
+	if appProtocol != "http" && !(appProtocol == "" && (port.Name == "http" || strings.HasPrefix(port.Name, "http-"))) {
+		return nil, fmt.Errorf("ServiceImport requires an HTTP port")
+	}
+	return &MCSImport{
+		MeshServiceImport: MeshServiceImport{
+			Namespace: imported.GetNamespace(), Projection: MCSProjectionName(imported.GetName()),
+			ImportUID: string(imported.GetUID()), VIP: ip.String(), Waypoint: waypointNS + "/" + waypointName, Port: uint32(port.Port),
+		},
+		Host:     imported.GetName() + "." + imported.GetNamespace() + ".svc.clusterset.local",
+		PortName: port.Name, apiVersion: imported.GetAPIVersion(), name: imported.GetName(), provider: provider,
+	}, nil
+}
+
+// MatchesProjection verifies the current source and the fields that define its mesh identity.
+func (imported *MCSImport) MatchesProjection(meta metav1.ObjectMeta, spec *istio.ServiceEntry) bool {
+	owner := MCSProjectionOwner(meta)
+	if owner == nil || string(owner.UID) != imported.ImportUID || owner.Name != imported.name ||
+		owner.APIVersion != imported.apiVersion || meta.Namespace != imported.Namespace || meta.DeletionTimestamp != nil ||
+		meta.Annotations[MCSProviderAnnotation] != imported.provider ||
+		cmp.Or(meta.Labels[label.IoIstioUseWaypointNamespace.Name], meta.Namespace)+"/"+meta.Labels[label.IoIstioUseWaypoint.Name] != imported.Waypoint ||
+		len(spec.Hosts) != 1 || spec.Hosts[0] != imported.Host || len(spec.Addresses) != 1 || spec.Addresses[0] != imported.VIP ||
+		spec.Resolution != istio.ServiceEntry_STATIC || spec.Location != istio.ServiceEntry_MESH_INTERNAL ||
+		spec.WorkloadSelector != nil || len(spec.Ports) != 1 {
+		return false
+	}
+	port := spec.Ports[0]
+	return port.GetName() == cmp.Or(imported.PortName, "http") && port.GetNumber() == imported.Port &&
+		port.GetProtocol() == "HTTP" && (port.GetTargetPort() == 0 || port.GetTargetPort() == imported.Port)
+}
+
+// IsMCSProjection identifies reserved projector objects, including ones missing an attestation field.
+func IsMCSProjection(meta metav1.ObjectMeta) bool {
+	if meta.Labels[MCSProjectorLabel] == MCSProjectorName {
+		return true
+	}
+	if !strings.HasPrefix(meta.Name, "hibiscus-mcs-") {
+		return false
+	}
+	if meta.Annotations[MCSProviderAnnotation] != "" {
+		return true
+	}
+	for _, owner := range meta.OwnerReferences {
+		if owner.Kind == MCSServiceImportKind && strings.HasPrefix(owner.APIVersion, MCSServiceImportGroup+"/") &&
+			meta.Name == MCSProjectionName(owner.Name) {
+			return true
+		}
+	}
+	return false
+}
+
+// MCSProjectionCurrent checks reserved projections against the same live import
+// observed by the route controller. Ordinary ServiceEntries pass unchanged.
+func MCSProjectionCurrent(
+	ctx krt.HandlerContext, imports krt.Collection[*unstructured.Unstructured], meta metav1.ObjectMeta, spec *istio.ServiceEntry,
+) bool {
+	if !IsMCSProjection(meta) {
+		return true
+	}
+	owner := MCSProjectionOwner(meta)
+	if imports == nil || owner == nil {
+		return false
+	}
+	obj := krt.FetchOne(ctx, imports, krt.FilterKey(meta.Namespace+"/"+owner.Name))
+	if obj == nil {
+		return false
+	}
+	imported, err := ReadMCSImport(*obj)
+	return err == nil && imported.MatchesProjection(meta, spec)
+}
+
+// MCSExportVisible checks the mesh export scope for the exact waypoint namespace.
+func MCSExportVisible(exportTo []string, ownerNamespace, waypointNamespace string) bool {
+	return exportTo == nil || slices.Contains(exportTo, "*") ||
+		(!slices.Contains(exportTo, "~") && (slices.Contains(exportTo, waypointNamespace) ||
+			(ownerNamespace == waypointNamespace && slices.Contains(exportTo, "."))))
+}
