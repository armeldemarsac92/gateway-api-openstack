+
+type serviceImportInputs struct {
+	imports         krt.Collection[*unstructured.Unstructured]
+	ambientServices krt.RecomputeProtected[*atomic.Pointer[krt.Collection[model.ServiceInfo]]]
+}
+
+func newServiceImportInputs(client kube.Client, opts krt.OptionsBuilder) *serviceImportInputs {
+	imports := krt.NewStaticCollection[*unstructured.Unstructured](nil, nil, opts.WithName("informer/ServiceImports")...)
+	watchServiceImports(client, imports, opts.Stop())
+	return &serviceImportInputs{
+		imports: imports,
+		ambientServices: krt.NewRecomputeProtected(atomic.NewPointer[krt.Collection[model.ServiceInfo]](nil),
+			true, opts.WithName("serviceImportAmbientServices")...),
+	}
+}
+
+// ServiceImports returns the shared opt-in Kubernetes input used by the mesh projection.
+func (c *Controller) ServiceImports() krt.Collection[*unstructured.Unstructured] {
+	if c.serviceImportInputs == nil {
+		return nil
+	}
+	return c.serviceImportInputs.imports
+}
+
+// SetAmbientServiceImportServices connects route reconciliation to the actual ambient service selection.
+func (c *Controller) SetAmbientServiceImportServices(services krt.Collection[model.ServiceInfo]) {
+	if c.serviceImportInputs != nil {
+		c.serviceImportInputs.ambientServices.Modify(func(p **atomic.Pointer[krt.Collection[model.ServiceInfo]]) {
+			(*p).Store(&services)
+		})
+	}
+}
+
+const serviceImportResource = "serviceimports"
+
+// The ordinary delayed informer reacts to CRD names once. For MCS, we need the served
+// version and must discard the previous informer's objects when the CRD changes.
+func watchServiceImports(client kube.Client, imports krt.StaticCollection[*unstructured.Unstructured], stop <-chan struct{}) {
+	factory := extinformers.NewSharedInformerFactoryWithOptions(client.Ext(), 0,
+		extinformers.WithTweakListOptions(func(opts *metav1.ListOptions) {
+			opts.FieldSelector = "metadata.name=" + serviceImportResource + "." + configgateway.MCSServiceImportGroup
+		}))
+	crds := factory.Apiextensions().V1().CustomResourceDefinitions()
+	informer := crds.Informer()
+
+	var mu sync.Mutex
+	var currentGVR schema.GroupVersionResource
+	var currentUID types.UID
+	var stopWatch chan struct{}
+	reconcile := func() {
+		mu.Lock()
+		defer mu.Unlock()
+
+		var gvr schema.GroupVersionResource
+		var uid types.UID
+		select {
+		case <-stop:
+		default:
+			crd, err := crds.Lister().Get(serviceImportResource + "." + configgateway.MCSServiceImportGroup)
+			if err == nil {
+				gvr = serviceImportGVR(crd)
+				uid = crd.UID
+			}
+		}
+		if currentGVR == gvr && currentUID == uid {
+			return
+		}
+		if stopWatch != nil {
+			close(stopWatch)
+			stopWatch = nil
+		}
+		// Withdraw data at a version/name reincarnation boundary before any new list can be read.
+		imports.Reset(nil)
+		currentGVR, currentUID = gvr, uid
+		if gvr.Empty() {
+			return
+		}
+		watchStop := make(chan struct{})
+		stopWatch = watchStop
+		dynamicFactory := dynamicinformer.NewDynamicSharedInformerFactory(client.Dynamic(), 0)
+		watch := dynamicFactory.ForResource(gvr).Informer()
+		change := func(obj any, deleted bool) {
+			mu.Lock()
+			defer mu.Unlock()
+			if stopWatch != watchStop {
+				return
+			}
+			imported := controllers.Extract[*unstructured.Unstructured](obj)
+			if imported == nil {
+				return
+			}
+			if deleted {
+				imports.DeleteObject(krt.GetKey(imported))
+			} else {
+				imports.UpdateObject(imported)
+			}
+		}
+		_, _ = watch.AddEventHandler(cache.ResourceEventHandlerFuncs{
+			AddFunc:    func(obj any) { change(obj, false) },
+			UpdateFunc: func(_, obj any) { change(obj, false) },
+			DeleteFunc: func(obj any) { change(obj, true) },
+		})
+		dynamicFactory.Start(watchStop)
+	}
+	_, _ = informer.AddEventHandler(cache.ResourceEventHandlerFuncs{
+		AddFunc:    func(any) { reconcile() },
+		UpdateFunc: func(any, any) { reconcile() },
+		DeleteFunc: func(any) { reconcile() },
+	})
+	factory.Start(stop)
+	go func() {
+		<-stop
+		reconcile()
+	}()
+}
+
+func serviceImportGVR(crd *extensions.CustomResourceDefinition) schema.GroupVersionResource {
+	if crd.DeletionTimestamp != nil || crd.Spec.Group != configgateway.MCSServiceImportGroup ||
+		crd.Spec.Names.Kind != configgateway.MCSServiceImportKind ||
+		crd.Spec.Names.Plural != serviceImportResource || crd.Spec.Scope != extensions.NamespaceScoped {
+		return schema.GroupVersionResource{}
+	}
+	established := false
+	for _, cond := range crd.Status.Conditions {
+		established = established || cond.Type == extensions.Established && cond.Status == extensions.ConditionTrue
+	}
+	if established {
+		for _, candidate := range []string{"v1beta1", "v1alpha1"} {
+			for _, version := range crd.Spec.Versions {
+				if version.Served && version.Name == candidate {
+					return schema.GroupVersionResource{Group: crd.Spec.Group, Version: candidate, Resource: serviceImportResource}
+				}
+			}
+		}
+	}
+	return schema.GroupVersionResource{}
+}
