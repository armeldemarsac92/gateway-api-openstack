+	assert.Equal(t, c.serviceImportInputs, nil)
+	assert.Equal(t, len(c.List(gvk.VirtualService, namespace)), 0)
+	queue := &TestStatusQueue{state: map[status.Resource]any{}}
+	setAndWait(t, c, queue)
+	assert.Equal(t, queue.Statuses(), []any{&k8s.HTTPRouteStatus{RouteStatus: k8s.RouteStatus{
+		Parents: []k8s.RouteParentStatus{other},
+	}}})
+}
