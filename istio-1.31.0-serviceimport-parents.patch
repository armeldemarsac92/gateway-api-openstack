+
+func TestWaypointServiceImportProducerRoute(t *testing.T) {
+	test.SetForTest(t, &features.EnableAmbient, true)
+	test.SetForTest(t, &features.EnableAmbientWaypoints, true)
+	test.SetForTest(t, &features.EnableAmbientMCSHTTPRoute, true)
+	test.SetForTest(t, &features.EnableAmbientMultiNetwork, false)
+	test.SetForTest(t, &features.EnableMCSHost, false)
+
+	const parent = "store"
+	const importedHost = "store.default.svc.clusterset.local"
+	const coreHost = "store.default.svc.cluster.local"
+	gvr := schema.GroupVersionResource{Group: configgateway.MCSServiceImportGroup, Version: "v1alpha1", Resource: "serviceimports"}
+	clusterSetVIP := "1.2.3.4"
+	projection := fmt.Sprintf(`apiVersion: networking.istio.io/v1
+kind: ServiceEntry
+metadata:
+  namespace: default
+  name: %s
+  annotations:
+    gateway-api-openstack.github.io/mcs-endpoint-slice-managed-by: mcs.example.io
+  labels:
+    gateway-api-openstack.github.io/managed-by: hibiscus-mcs-projector
+    istio.io/use-waypoint: waypoint
+  ownerReferences:
+  - apiVersion: multicluster.x-k8s.io/v1alpha1
+    kind: ServiceImport
+    name: store
+    uid: import-1
+    controller: true
+spec:
+  hosts: [%s]
+  addresses: [%s]
+  ports:
+  - number: 80
+    name: http
+    protocol: HTTP
+  location: MESH_INTERNAL
+  resolution: STATIC
+  endpoints:
+  - address: 1.1.1.8
+    ports:
+      http: 8080`, configgateway.MCSProjectionName(parent), importedHost, clusterSetVIP)
+	object, _, err := kube.IstioCodec.UniversalDeserializer().Decode([]byte(projection), nil, nil)
+	assert.NoError(t, err)
+	base := joinYaml(waypointGateway, waypointSvc, waypointInstance, `apiVersion: gateway.networking.k8s.io/v1
+kind: GatewayClass
+metadata:
+  name: waypoint
+spec:
+  controllerName: istio.io/mesh-controller`, `apiVersion: v1
+kind: Service
+metadata:
+  name: store
+  namespace: default
+  labels:
+    istio.io/use-waypoint: waypoint
+spec:
+  clusterIP: 1.2.3.5
+  ports:
+  - name: http
+    port: 80`, `apiVersion: discovery.k8s.io/v1
+kind: EndpointSlice
+metadata:
+  namespace: default
+  name: store-core
+  labels:
+    kubernetes.io/service-name: store
+addressType: IPv4
+ports:
+- name: http
+  protocol: TCP
+  port: 8081
+endpoints:
+- addresses: [1.1.1.9]
+  conditions:
+    ready: true`,
+		projection, `apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: producer
+  namespace: default
+spec:
+  parentRefs:
+  - group: multicluster.x-k8s.io
+    kind: ServiceImport
+    name: store
+    port: 80
+  rules:
+  - matches:
+    - path:
+        type: Exact
+        value: /cart
+    backendRefs:
+    - name: store
+      port: 80
+  - matches:
+    - path:
+        type: Exact
+        value: /missing
+    backendRefs:
+    - group: multicluster.x-k8s.io
+      kind: ServiceImport
+      name: missing
+      port: 80
+  - matches:
+    - path:
+        type: Exact
+        value: /wrong-port
+    backendRefs:
+    - group: multicluster.x-k8s.io
+      kind: ServiceImport
+      name: store
+      port: 81
+  - backendRefs:
+    - group: multicluster.x-k8s.io
+      kind: ServiceImport
+      name: store
+      port: 80`)
+	d := xds.NewFakeDiscoveryServer(t, xds.FakeOptions{
+		ConfigString:           waypointInstance,
+		Configs:                []config.Config{crdclient.TranslateObject(object, gvk.ServiceEntry, "cluster.local")},
+		KubernetesObjectString: base,
+	})
+	proxy := d.SetupProxy(&model.Proxy{
+		Type:            model.Waypoint,
+		ConfigNamespace: "default",
+		Labels: map[string]string{
+			label.IoK8sNetworkingGatewayGatewayName.Name: "waypoint",
+			label.GatewayManaged.Name:                    constants.ManagedGatewayMeshControllerLabel,
+		},
+		IPAddresses: []string{"3.0.0.1"},
+	})
+	importCluster := model.BuildSubsetKey(model.TrafficDirectionInboundVIP, "http", importedHost, 80)
+	coreCluster := model.BuildSubsetKey(model.TrafficDirectionInboundVIP, "http", coreHost, 80)
+	waypointRoutes := func(cluster string) []*envoyroute.Route {
+		proxy.SetSidecarScope(d.PushContext())
+		l := xdstest.ExtractListener("main_internal", d.Listeners(proxy))
+		chain := xdstest.ExtractFilterChain(cluster, l)
+		if chain == nil {
+			return nil
+		}
+		var routes []*envoyroute.Route
+		for _, host := range xdstest.ExtractHTTPConnectionManager(t, chain).GetRouteConfig().GetVirtualHosts() {
+			routes = append(routes, host.GetRoutes()...)
+		}
+		return routes
+	}
+	routeClusters := func(cluster string) []string {
+		var clusters []string
+		for _, route := range waypointRoutes(cluster) {
+			clusters = append(clusters, route.GetRoute().GetCluster())
+		}
+		return clusters
+	}
+	assert.Equal(t, routeClusters(importCluster), nil)
+	assert.EventuallyEqual(t, func() []string { return routeClusters(coreCluster) }, []string{coreCluster})
+
+	// Apply the real parent after the route and install the CRD late, as a provider would.
+	ctx := context.Background()
+	client := d.KubeClient().Dynamic().Resource(gvr).Namespace("default")
+	imported, err := client.Create(ctx, &unstructured.Unstructured{Object: map[string]any{
+		"apiVersion": gvr.GroupVersion().String(),
+		"kind":       "ServiceImport",
+		"metadata": map[string]any{
+			"name": parent, "namespace": "default", "uid": "import-1",
+			"labels":      map[string]any{"istio.io/use-waypoint": "waypoint"},
+			"annotations": map[string]any{configgateway.MCSProviderAnnotation: "mcs.example.io"},
+		},
+		"spec": map[string]any{
+			"type": "ClusterSetIP", "ips": []any{clusterSetVIP},
+			"ports": []any{map[string]any{"port": int64(80), "name": "http", "protocol": "TCP"}},
+		},
+		"status": map[string]any{"endpointSliceObjects": "Present"},
+	}}, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	_, err = d.KubeClient().Ext().ApiextensionsV1().CustomResourceDefinitions().Create(ctx, &extensions.CustomResourceDefinition{
+		ObjectMeta: metav1.ObjectMeta{Name: "serviceimports.multicluster.x-k8s.io", UID: "mcs-crd"},
+		Spec: extensions.CustomResourceDefinitionSpec{
+			Group: gvr.Group, Scope: extensions.NamespaceScoped,
+			Names:    extensions.CustomResourceDefinitionNames{Kind: "ServiceImport", Plural: "serviceimports"},
+			Versions: []extensions.CustomResourceDefinitionVersion{{Name: gvr.Version, Served: true, Storage: true}},
+		},
+		Status: extensions.CustomResourceDefinitionStatus{Conditions: []extensions.CustomResourceDefinitionCondition{
+			{Type: extensions.Established, Status: extensions.ConditionTrue},
+		}},
+	}, metav1.CreateOptions{})
+	assert.NoError(t, err)
+
+	active := []string{"UnknownService", "UnknownService", coreCluster, importCluster}
+	assert.EventuallyEqual(t, func() []string { return routeClusters(importCluster) }, active)
+	for _, r := range waypointRoutes(importCluster) {
+		if r.GetRoute().GetCluster() == "UnknownService" {
+			assert.Equal(t, r.GetRoute().GetClusterNotFoundResponseCode(), envoyroute.RouteAction_INTERNAL_SERVER_ERROR)
+		}
+	}
+	assert.Equal(t, routeClusters(coreCluster), []string{coreCluster})
+	endpointAddresses := func(cluster string) []string {
+		// A connected proxy refreshes its scope on a service push. Mirror that for this synthetic proxy.
+		proxy.SetSidecarScope(d.PushContext())
+		for _, cla := range d.Endpoints(proxy) {
+			if cla.GetClusterName() == cluster {
+				return xdstest.ExtractEndpoints(cla)
+			}
+		}
+		return nil
+	}
+	assert.EventuallyEqual(t, func() []string { return endpointAddresses(importCluster) }, []string{"1.1.1.8:8080"})
+	assert.Equal(t, endpointAddresses(coreCluster), []string{"1.1.1.9:8081"})
+
+	// The GatewayClass may change while the projection and import stay the same.
+	gwAPI := d.KubeClient().GatewayAPI().GatewayV1()
+	foreignClass := &gatewayv1.GatewayClass{
+		ObjectMeta: metav1.ObjectMeta{Name: "foreign"},
+		Spec:       gatewayv1.GatewayClassSpec{ControllerName: "example.org/other-mesh"},
+	}
+	_, err = gwAPI.GatewayClasses().Create(ctx, foreignClass, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	gateways := gwAPI.Gateways("default")
+	gateway, err := gateways.Get(ctx, "waypoint", metav1.GetOptions{})
+	assert.NoError(t, err)
+	gateway.Spec.GatewayClassName = "foreign"
+	gateway, err = gateways.Update(ctx, gateway, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	assert.EventuallyEqual(t, func() bool {
+		svc := d.AmbientIndex.ServiceInfo("default/" + importedHost)
+		return svc != nil && svc.Service.GetWaypoint() == nil && len(routeClusters(importCluster)) == 0
+	}, true)
+	gateway.Spec.GatewayClassName = "waypoint"
+	_, err = gateways.Update(ctx, gateway, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	assert.EventuallyEqual(t, func() []string { return routeClusters(importCluster) }, active)
+
+	// With the live import still enrolled, removing a Route restores the projected default backend.
+	routes := gwAPI.HTTPRoutes("default")
+	producer, err := routes.Get(ctx, "producer", metav1.GetOptions{})
+	assert.NoError(t, err)
+	assert.NoError(t, routes.Delete(ctx, "producer", metav1.DeleteOptions{}))
+	assert.EventuallyEqual(t, func() []string { return routeClusters(importCluster) }, []string{importCluster})
+	producer.ResourceVersion = ""
+	_, err = routes.Create(ctx, producer, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	assert.EventuallyEqual(t, func() []string { return routeClusters(importCluster) }, active)
+
+	// The still-persisted projection and its rules must be withdrawn if the attestation is removed.
+	imported.SetAnnotations(nil)
+	_, err = client.Update(ctx, imported, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	assert.EventuallyEqual(t, func() bool {
+		return len(d.Env().GatewayAPIController.List(gvk.VirtualService, "default")) == 0 &&
+			d.AmbientIndex.ServiceInfo("default/"+importedHost) == nil &&
+			d.Env().PushContext().ServiceIndex.HostnameAndNamespace[importedHost]["default"] == nil &&
+			len(routeClusters(importCluster)) == 0
+	}, true)
+	assert.Equal(t, routeClusters(coreCluster), []string{coreCluster})
+}
