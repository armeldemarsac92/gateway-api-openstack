+func TestServiceImportRouteReconciliation(t *testing.T) {
+	test.SetForTest(t, &features.EnableGatewayAPI, true)
+	test.SetForTest(t, &features.EnableAmbient, true)
+	test.SetForTest(t, &features.EnableAmbientWaypoints, true)
+	test.SetForTest(t, &features.EnableAmbientMCSHTTPRoute, true)
+	test.SetForTest(t, &features.EnableAmbientMultiNetwork, false)
+	test.SetForTest(t, &features.EnableMCSHost, false)
+
+	const namespace = "store"
+	const hostname = "api.store.svc.clusterset.local"
+	const coreHost = "api.store.svc.cluster.local"
+	const vip = "1.2.3.4"
+	ref := k8s.ParentReference{
+		Group: ptr.Of(k8s.Group(configgateway.MCSServiceImportGroup)), Kind: ptr.Of(k8s.Kind("ServiceImport")),
+		Name: "api", Port: ptr.Of(k8s.PortNumber(80)), SectionName: ptr.Of(k8s.SectionName("http")),
+	}
+	foreign := k8s.RouteParentStatus{
+		ParentRef: ref, ControllerName: "other.example/controller",
+		Conditions: []metav1.Condition{{Type: "Accepted", Status: metav1.ConditionTrue}},
+	}
+	route := &k8s.HTTPRoute{
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: "producer", Generation: 3},
+		Spec: k8s.HTTPRouteSpec{
+			CommonRouteSpec: k8s.CommonRouteSpec{ParentRefs: []k8s.ParentReference{
+				ref, {Group: ptr.Of(k8s.Group("")), Kind: ptr.Of(k8s.Kind("Service")), Name: "api"},
+			}},
+			Rules: []k8s.HTTPRouteRule{{BackendRefs: []k8s.HTTPBackendRef{{BackendRef: k8s.BackendRef{
+				BackendObjectReference: k8s.BackendObjectReference{Name: "api", Port: ptr.Of(k8s.PortNumber(80))},
+			}}}}},
+		},
+		Status: k8s.HTTPRouteStatus{RouteStatus: k8s.RouteStatus{Parents: []k8s.RouteParentStatus{foreign}}},
+	}
+	alpha := schema.GroupVersionResource{Group: configgateway.MCSServiceImportGroup, Version: "v1alpha1", Resource: serviceImportResource}
+	beta := alpha
+	beta.Version = "v1beta1"
+	dynamicClient := dynamicfake.NewSimpleDynamicClientWithCustomListKinds(runtime.NewScheme(),
+		map[schema.GroupVersionResource]string{alpha: "ServiceImportList", beta: "ServiceImportList"})
+	client := serviceImportFakeClient{
+		CLIClient: kube.NewFakeClient(route,
+			&corev1.Service{ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: "api"},
+				Spec: corev1.ServiceSpec{ClusterIP: "1.2.3.5"}},
+			&k8s.Gateway{ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: "waypoint"},
+				Spec: k8s.GatewaySpec{GatewayClassName: "mesh"}},
+			&k8s.GatewayClass{ObjectMeta: metav1.ObjectMeta{Name: "mesh"},
+				Spec: k8s.GatewayClassSpec{ControllerName: constants.ManagedGatewayMeshController}}),
+		dynamicClient: dynamicClient,
+	}
+	setupClientCRDs(t, client)
+	stop := test.NewStop(t)
+	c := NewController(client, func(schema.GroupVersionResource, <-chan struct{}) bool { return false },
+		controller.Options{DomainSuffix: "cluster.local"}, nil)
+	ambient := krt.NewStaticCollection[model.ServiceInfo](nil, nil, krt.WithStop(stop))
+	c.SetAmbientServiceImportServices(ambient)
+	client.RunAndWait(stop)
+	go c.Run(stop)
+	c.Reconcile(core.NewConfigGenTest(t, core.TestOptions{}).PushContext())
+
+	queue := &TestStatusQueue{state: map[status.Resource]any{}}
+	setAndWait(t, c, queue)
+	assertRoute := func(wantAccepted, wantWaypoint metav1.ConditionStatus, wantImports int) {
+		t.Helper()
+		assert.EventuallyEqual(t, func() int {
+			count := 0
+			for _, vs := range c.List(gvk.VirtualService, namespace) {
+				spec := vs.Spec.(*istio.VirtualService)
+				if spec.GetHosts()[0] == hostname {
+					count++
+					assert.Equal(t, spec.GetHttp()[0].GetRoute()[0].GetDestination().GetHost(), coreHost)
+					_, producer := vs.Extra[constants.ConfigExtraMeshServiceImport]
+					assert.Equal(t, producer, true)
+				}
+			}
+			return count
+		}, wantImports)
+		assert.EventuallyEqual(t, func() bool {
+			for _, st := range queue.Statuses() {
+				http, ok := st.(*k8s.HTTPRouteStatus)
+				if !ok {
+					continue
+				}
+				var accepted, resolvedWP *metav1.Condition
+				var other bool
+				for _, p := range http.Parents {
+					if p.ControllerName == foreign.ControllerName {
+						assert.Equal(t, p, foreign)
+						other = true
+					} else if p.ParentRef.Kind != nil && *p.ParentRef.Kind == *ref.Kind {
+						for i := range p.Conditions {
+							cond := &p.Conditions[i]
+							switch cond.Type {
+							case string(k8s.RouteConditionAccepted):
+								accepted = cond
+							case string(RouteConditionResolvedWaypoints):
+								resolvedWP = cond
+							}
+						}
+					}
+				}
+				return other && accepted != nil && resolvedWP != nil && accepted.Status == wantAccepted &&
+					accepted.ObservedGeneration == 3 && resolvedWP.Status == wantWaypoint
+			}
+			return false
+		}, true)
+	}
+	assertRoute(metav1.ConditionFalse, metav1.ConditionFalse, 0)
+	ctx := context.Background()
+	newImport := func(version, uid string) *unstructured.Unstructured {
+		return &unstructured.Unstructured{Object: map[string]any{
+			"apiVersion": configgateway.MCSServiceImportGroup + "/" + version,
+			"kind":       "ServiceImport",
+			"metadata": map[string]any{
+				"namespace": namespace, "name": "api", "uid": uid,
+				"labels":      map[string]any{"istio.io/use-waypoint": "waypoint"},
+				"annotations": map[string]any{configgateway.MCSProviderAnnotation: "mcs.example.io"},
+			},
+			"spec": map[string]any{
+				"type": "ClusterSetIP", "ips": []any{vip},
+				"ports": []any{map[string]any{"port": int64(80), "name": "http", "protocol": "TCP"}},
+			},
+			"status": map[string]any{"endpointSliceObjects": "Present"},
+		}}
+	}
+	alphaImports := dynamicClient.Resource(alpha).Namespace(namespace)
+	_, err := alphaImports.Create(ctx, newImport(alpha.Version, "old"), metav1.CreateOptions{})
+	assert.NoError(t, err)
+	crds := client.Ext().ApiextensionsV1().CustomResourceDefinitions()
+	crd, err := crds.Create(ctx, &extensions.CustomResourceDefinition{
+		ObjectMeta: metav1.ObjectMeta{Name: "serviceimports.multicluster.x-k8s.io", UID: "mcs-crd"},
+		Spec: extensions.CustomResourceDefinitionSpec{
+			Group: alpha.Group, Scope: extensions.NamespaceScoped,
+			Names: extensions.CustomResourceDefinitionNames{Kind: "ServiceImport", Plural: serviceImportResource},
+			Versions: []extensions.CustomResourceDefinitionVersion{
+				{Name: beta.Version, Served: false}, {Name: alpha.Version, Served: true, Storage: true},
+			},
+		},
+		Status: extensions.CustomResourceDefinitionStatus{Conditions: []extensions.CustomResourceDefinitionCondition{
+			{Type: extensions.Established, Status: extensions.ConditionTrue},
+		}},
+	}, metav1.CreateOptions{})
+	assert.NoError(t, err)
+
+	projection := &networkingclient.ServiceEntry{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: configgateway.MCSProjectionName("api"), Namespace: namespace,
+			Labels:      map[string]string{configgateway.MCSProjectorLabel: configgateway.MCSProjectorName, "istio.io/use-waypoint": "waypoint"},
+			Annotations: map[string]string{configgateway.MCSProviderAnnotation: "mcs.example.io"},
+			OwnerReferences: []metav1.OwnerReference{
+				{APIVersion: alpha.GroupVersion().String(), Kind: "ServiceImport", Name: "api", UID: "old", Controller: ptr.Of(true)},
+			},
+		},
+		Spec: istio.ServiceEntry{
+			Hosts: []string{hostname}, Addresses: []string{vip}, Resolution: istio.ServiceEntry_STATIC, Location: istio.ServiceEntry_MESH_INTERNAL,
+			Ports: []*istio.ServicePort{{Name: "http", Number: 80, Protocol: "HTTP"}},
+		},
+	}
+	ses := client.Istio().NetworkingV1().ServiceEntries(namespace)
+	projection, err = ses.Create(ctx, projection, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	setAmbient := func(uid string) {
+		ambient.UpdateObject(model.ServiceInfo{
+			Source:       model.TypedObject{Kind: kind.ServiceEntry, NamespacedName: types.NamespacedName{Namespace: namespace, Name: projection.Name}},
+			MCSImportUID: uid,
+			Waypoint:     model.WaypointBindingStatus{ResourceName: namespace + "/waypoint"},
+			Service: &workloadapi.Service{
+				Namespace: namespace, Name: projection.Name, Hostname: hostname,
+				Addresses: []*workloadapi.NetworkAddress{{Address: netip.MustParseAddr(vip).AsSlice()}},
+				Ports:     []*workloadapi.Port{{ServicePort: 80}},
+				Waypoint:  &workloadapi.GatewayAddress{},
+			},
+		})
+	}
+	setAmbient("old")
+	assertRoute(metav1.ConditionTrue, metav1.ConditionTrue, 1)
+
+	assert.NoError(t, ses.Delete(ctx, projection.Name, metav1.DeleteOptions{}))
+	assertRoute(metav1.ConditionFalse, metav1.ConditionFalse, 0)
+	projection.ResourceVersion = ""
+	projection, err = ses.Create(ctx, projection, metav1.CreateOptions{})
+	assert.NoError(t, err)
+	assertRoute(metav1.ConditionTrue, metav1.ConditionTrue, 1)
+
+	// Switch the served resource while the projection is still owned by the previous incarnation.
+	betaImports := dynamicClient.Resource(beta).Namespace(namespace)
+	_, err = betaImports.Create(ctx, newImport(beta.Version, "new"), metav1.CreateOptions{})
+	assert.NoError(t, err)
+	crd.Spec.Versions[0].Served = true
+	crd.Spec.Versions[1].Served = false
+	_, err = crds.Update(ctx, crd, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	assertRoute(metav1.ConditionFalse, metav1.ConditionFalse, 0)
+	projection.OwnerReferences[0].APIVersion = beta.GroupVersion().String()
+	projection.OwnerReferences[0].UID = "new"
+	_, err = ses.Update(ctx, projection, metav1.UpdateOptions{})
+	assert.NoError(t, err)
+	setAmbient("new")
+	assertRoute(metav1.ConditionTrue, metav1.ConditionTrue, 1)
+
+	assert.NoError(t, crds.Delete(ctx, crd.Name, metav1.DeleteOptions{}))
+	assertRoute(metav1.ConditionFalse, metav1.ConditionFalse, 0)
+}
+
+func TestServiceImportRouteOptOutPreservesForeignStatus(t *testing.T) {
+	test.SetForTest(t, &features.EnableAmbientMCSHTTPRoute, false)
+	const namespace = "default"
+	ref := k8s.ParentReference{
+		Group: ptr.Of(k8s.Group(configgateway.MCSServiceImportGroup)), Kind: ptr.Of(k8s.Kind("ServiceImport")), Name: "api",
+	}
+	other := k8s.RouteParentStatus{ParentRef: ref, ControllerName: "other.example/controller"}
+	route := &k8s.HTTPRoute{
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: "producer"},
+		Spec:       k8s.HTTPRouteSpec{CommonRouteSpec: k8s.CommonRouteSpec{ParentRefs: []k8s.ParentReference{ref}}},
+		Status: k8s.HTTPRouteStatus{RouteStatus: k8s.RouteStatus{Parents: []k8s.RouteParentStatus{
+			other, {ParentRef: ref, ControllerName: k8s.GatewayController(features.ManagedGatewayController)},
+		}}},
