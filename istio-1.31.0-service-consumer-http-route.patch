+func (parent routeParentReference) isMeshConsumerService(namespace string) bool {
+	return parent.IsMesh() && parent.InternalKind == gvk.Service && parent.ParentKey.Namespace != namespace
+}
+
+func configureWaypointConsumerParent(ctx RouteContext, parent *routeParentReference, obj controllers.Object) {
+	if !features.EnableAmbientWaypoints || parent.DeniedReason != nil || !parent.isMeshConsumerService(obj.GetNamespace()) {
+		return
+	}
+	var http *gatewayv1.HTTPRoute
+	switch route := obj.(type) {
+	case *gatewayv1.HTTPRoute:
+		http = route
+	case *gatewayv1.GRPCRoute:
+	default:
+		return
+	}
+
+	key := parent.ParentKey
+	service := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.Services, krt.FilterKey(key.Namespace+"/"+key.Name)))
+	if service == nil {
+		return
+	}
+	namespace := ptr.Flatten(krt.FetchOne(ctx.Krt, ctx.Namespaces, krt.FilterKey(key.Namespace)))
+	var nsMeta *metav1.ObjectMeta
+	var nsLabels map[string]string
+	if namespace != nil {
+		nsMeta = &namespace.ObjectMeta
+		nsLabels = namespace.Labels
+	}
+	waypointLabels := service.Labels
+	if _, present := waypointLabels[label.IoIstioUseWaypoint.Name]; !present {
+		waypointLabels = nsLabels
+	}
+	if !waypointConfigured(waypointLabels) {
+		return // Keep the existing sidecar configuration for Services without a waypoint.
+	}
+	_, ingress := model.IngressUseWaypointFromLabels(service.Labels, nsLabels)
+	var message string
+	switch {
+	case features.EnableAmbientMultiNetwork || ingress:
+		message = "consumer routes require a single-network Service waypoint without ingress forwarding"
+	case ambient.HasActiveServiceWaypointCanary(service.ObjectMeta, nsMeta):
+		message = "consumer routes require a single Service waypoint with canary forwarding disabled"
+	case service.Spec.Type == corev1.ServiceTypeExternalName || service.Spec.ClusterIP == corev1.ClusterIPNone:
+		message = "consumer routes require a Kubernetes Service VIP"
+	case http == nil:
+		message = "the ambient consumer route subset supports HTTPRoute"
+	default:
+		message = waypointConsumerHTTPRouteError(http, *parent, service)
+	}
+	if message != "" {
+		parent.DeniedReason = &ParentError{Reason: ParentErrorUnsupportedValue, Message: message}
+		return
+	}
+	parent.WaypointConsumer = true
+}
+
+func waypointConsumerHTTPRouteError(route *gatewayv1.HTTPRoute, parent routeParentReference, service *corev1.Service) string {
+	for i, rule := range route.Spec.Rules {
+		fail := func(message string) string { return fmt.Sprintf("consumer HTTPRoute rule %d: %s", i+1, message) }
+		if rule.Timeouts != nil || rule.Retry != nil || rule.SessionPersistence != nil {
+			return fail("only response header modification and forwarding are supported")
+		}
+		for _, match := range rule.Matches {
+			if match.Path != nil {
+				switch ptr.OrDefault(match.Path.Type, gatewayv1.PathMatchPathPrefix) {
+				case gatewayv1.PathMatchExact, gatewayv1.PathMatchPathPrefix:
+				default:
+					return fail("only Exact and PathPrefix path matches are supported")
+				}
+			}
+			for _, header := range waypointConsumerHeaderMatches(match.Headers) {
+				if ptr.OrDefault(header.Type, gatewayv1.HeaderMatchExact) != gatewayv1.HeaderMatchExact {
+					return fail("only Exact header matches are supported")
+				}
+				if !httpguts.ValidHeaderFieldName(string(header.Name)) || !isValidHeaderValue(header.Value) {
+					return fail("invalid header match")
+				}
+			}
+			for _, query := range match.QueryParams {
+				if ptr.OrDefault(query.Type, gatewayv1.QueryParamMatchExact) != gatewayv1.QueryParamMatchExact {
+					return fail("only Exact query parameter matches are supported")
+				}
+			}
+		}
+		if len(rule.BackendRefs) != 1 {
+			return fail("one BackendRef to the parent Service is required")
+		}
+		backend := rule.BackendRefs[0]
+		ref := gatewaycommon.NormalizeReference(backend.Group, backend.Kind, gvk.Service)
+		if ref != gvk.Service || string(backend.Name) != service.Name ||
+			string(ptr.OrDefault(backend.Namespace, gatewayv1.Namespace(route.Namespace))) != service.Namespace ||
+			backend.Port == nil || ptr.OrDefault(backend.Weight, 1) <= 0 || len(backend.Filters) != 0 {
+			return fail("the backend must forward all traffic to the parent Kubernetes Service with an explicit port and no backend filters")
+		}
+		port := *backend.Port
+		if parent.OriginalReference.Port != nil && *parent.OriginalReference.Port != port {
+			return fail("backend port must match the Service parent port")
+		}
+		section := ptr.OrEmpty(parent.OriginalReference.SectionName)
+		if slices.FindFunc(service.Spec.Ports, func(p corev1.ServicePort) bool {
+			protocol := configkube.ConvertProtocol(p.Port, p.Name, p.Protocol, p.AppProtocol)
+			return gatewayv1.PortNumber(p.Port) == port && (section == "" || string(section) == p.Name) &&
+				(protocol.IsHTTP() || protocol.IsUnsupported())
+		}) == nil {
+			return fail("the backend port must be an HTTP-capable port of the parent Service")
+		}
+		if len(rule.Filters) != 1 {
+			return fail("one ResponseHeaderModifier filter is required")
+		}
+		filter := rule.Filters[0]
+		if filter.Type != gatewayv1.HTTPRouteFilterResponseHeaderModifier || filter.ResponseHeaderModifier == nil {
+			return fail("only ResponseHeaderModifier filters are supported")
+		}
+		headers := filter.ResponseHeaderModifier
+		if len(headers.Set)+len(headers.Add)+len(headers.Remove) == 0 {
+			return fail("at least one response header operation is required")
+		}
+		for _, h := range headers.Set {
+			if invalidConsumerResponseHeader(string(h.Name)) || !isValidHeaderValue(h.Value) {
+				return fail("invalid or reserved response header")
+			}
+		}
+		for _, h := range headers.Add {
+			if invalidConsumerResponseHeader(string(h.Name)) || !isValidHeaderValue(h.Value) {
+				return fail("invalid or reserved response header")
+			}
+		}
+		for _, h := range headers.Remove {
+			if invalidConsumerResponseHeader(h) {
+				return fail("invalid or reserved response header")
+			}
+		}
+	}
+	return ""
+}
+
+// Gateway API uses only the first match for each case-insensitive header name.
+func waypointConsumerHeaderMatches(headers []gatewayv1.HTTPHeaderMatch) []gatewayv1.HTTPHeaderMatch {
+	if len(headers) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(headers))
+	result := make([]gatewayv1.HTTPHeaderMatch, 0, len(headers))
+	for _, header := range headers {
+		name := textproto.CanonicalMIMEHeaderKey(string(header.Name))
+		if _, found := seen[name]; found {
+			continue
+		}
+		seen[name] = struct{}{}
+		result = append(result, header)
+	}
+	return result
+}
+
+func invalidConsumerResponseHeader(name string) bool {
+	switch strings.ToLower(name) {
+	case "host", "connection", "content-length", "keep-alive", "proxy-connection", "te", "trailer", "transfer-encoding", "upgrade":
+		return true
+	}
+	return !httpguts.ValidHeaderFieldName(name)
+}
+
+func waypointConsumerVirtualServices(obj *gatewayv1.HTTPRoute, parent routeParentReference, domain string, routes []*istio.HTTPRoute, start int) []RouteWithKey {
+	key := parent.ParentKey
+	hostname := key.Name + "." + key.Namespace + ".svc." + domain
+	// Each admitted rule has a single backend. Its port is also the effective
+	// listener port when the parent omitted a port. One key for both forms
+	// lets the regular Gateway API sorter compare their matches together.
+	byPort := make(map[uint32][]*istio.HTTPRoute)
+	for _, rule := range routes {
+		if len(rule.Route) != 1 || rule.Route[0].GetDestination().GetHost() != hostname {
+			continue
+		}
+		port := rule.Route[0].GetDestination().GetPort().GetNumber()
+		if port != 0 {
+			byPort[port] = append(byPort[port], rule)
+		}
+	}
+	var out []RouteWithKey
+	for _, port := range slices.Sort(maps.Keys(byPort)) {
+		rules := augmentPortMatch(byPort[port], gatewayv1.PortNumber(port))
+		for _, rule := range rules {
+			for _, match := range rule.Match {
+				if match.Uri == nil {
+					match.Uri = &istio.StringMatch{MatchType: &istio.StringMatch_Prefix{Prefix: "/"}}
+				}
+			}
+		}
+		sortHTTPRoutes(rules)
+		out = append(out, RouteWithKey{
+			Key: obj.Namespace + "/consumer/" + strconv.FormatUint(uint64(port), 10) + "/" + hostname,
+			Config: config.Config{
+				Meta: config.Meta{
+					CreationTimestamp: obj.CreationTimestamp.Time,
+					GroupVersionKind:  gvk.VirtualService,
+					Name:              obj.Name + "~" + strconv.Itoa(start+len(out)) + "~" + constants.KubernetesGatewayName,
+					Annotations:       routeMeta(obj),
+					Namespace:         obj.Namespace,
+					Domain:            domain,
+				},
+				Spec: &istio.VirtualService{
+					Hosts:    []string{hostname},
+					Gateways: []string{parent.InternalName},
+					Http:     rules,
+				},
+				Extra: map[string]any{constants.ConfigExtraMeshConsumerService: kube.MeshConsumerService{
+					Namespace: key.Namespace, Name: key.Name, Port: port,
+				}},
+			},
+		})
+	}
+	return out
+}
