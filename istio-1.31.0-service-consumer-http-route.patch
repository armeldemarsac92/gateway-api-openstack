+// HasActiveServiceWaypointCanary reports whether the configured Service binding enables
+// forwarding to a distinct canary. An unavailable canary may later become ready.
+func HasActiveServiceWaypointCanary(service metav1.ObjectMeta, nsMeta *metav1.ObjectMeta) bool {
+	primary, disabled := GetUseWaypoint(service, service.Namespace)
+	if disabled {
+		return false
+	}
+	if primary != nil {
+		nsMeta = nil
+	} else if nsMeta != nil {
+		primary, _ = GetUseWaypoint(*nsMeta, service.Namespace)
+	}
+	if primary == nil {
+		return false
+	}
+	canary := getUseWaypointCanary(service, nsMeta, service.Namespace)
+	if canary == nil || *canary == *primary {
+		return false
+	}
+	weight, valid := getCanaryWeight(service, nsMeta)
+	return valid && weight > 0
+}
