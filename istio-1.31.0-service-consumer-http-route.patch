+		}},
+		{"invalid Add name", func(r *gatewayv1.HTTPRouteRule) {
+			r.Filters[0].ResponseHeaderModifier.Add = []gatewayv1.HTTPHeader{{Name: "X Result", Value: "value"}}
+		}},
+		{"invalid Remove name", func(r *gatewayv1.HTTPRouteRule) {
+			r.Filters[0].ResponseHeaderModifier.Remove = []string{"X Result"}
+		}},
+		{"other Service", func(r *gatewayv1.HTTPRouteRule) { r.BackendRefs[0].Name = "other" }},
+		{"different port", func(r *gatewayv1.HTTPRouteRule) { r.BackendRefs[0].Port = ptr.Of(gatewayv1.PortNumber(8080)) }},
+		{"disabled backend", func(r *gatewayv1.HTTPRouteRule) { r.BackendRefs[0].Weight = ptr.Of(int32(0)) }},
+		{"backend filters", func(r *gatewayv1.HTTPRouteRule) { r.BackendRefs[0].Filters = r.Filters }},
+	} {
