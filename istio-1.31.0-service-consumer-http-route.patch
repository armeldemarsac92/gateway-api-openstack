+func TestWaypointConsumerHTTPRouteContract(t *testing.T) {
+	service := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "producer", Name: "echo"},
+		Spec: corev1.ServiceSpec{Ports: []corev1.ServicePort{
+			{Name: "http", Port: 80, Protocol: corev1.ProtocolTCP},
+			{Name: "http-alt", Port: 8080, Protocol: corev1.ProtocolTCP},
+		}},
+	}
+	route := &gatewayv1.HTTPRoute{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "consumer"},
+		Spec: gatewayv1.HTTPRouteSpec{Rules: []gatewayv1.HTTPRouteRule{{
+			Matches: []gatewayv1.HTTPRouteMatch{{
+				Headers:     []gatewayv1.HTTPHeaderMatch{{Name: "X_Request-ID", Value: "sample"}},
+				QueryParams: []gatewayv1.HTTPQueryParamMatch{{Name: "page", Value: "1"}},
+			}},
+			Filters: []gatewayv1.HTTPRouteFilter{{
+				Type:                   gatewayv1.HTTPRouteFilterResponseHeaderModifier,
+				ResponseHeaderModifier: &gatewayv1.HTTPHeaderFilter{Set: []gatewayv1.HTTPHeader{{Name: "X-Result", Value: "value"}}},
+			}},
+			BackendRefs: []gatewayv1.HTTPBackendRef{{BackendRef: gatewayv1.BackendRef{
+				BackendObjectReference: gatewayv1.BackendObjectReference{
+					Name: "echo", Namespace: ptr.Of(gatewayv1.Namespace("producer")), Port: ptr.Of(gatewayv1.PortNumber(80)),
+				},
+			}}},
+		}}},
+	}
+
+	parent := routeParentReference{OriginalReference: gatewayv1.ParentReference{Port: ptr.Of(gatewayv1.PortNumber(80))}}
+	for _, duplicateType := range []gatewayv1.HeaderMatchType{gatewayv1.HeaderMatchExact, gatewayv1.HeaderMatchRegularExpression} {
+		t.Run("ignore duplicate "+string(duplicateType)+" match", func(t *testing.T) {
+			consumer := route.DeepCopy()
+			rule := consumer.Spec.Rules[0]
+			rule.Matches[0].Headers = append(rule.Matches[0].Headers, gatewayv1.HTTPHeaderMatch{
+				Name: "x_request-id", Value: "different", Type: &duplicateType,
+			})
+			if message := waypointConsumerHTTPRouteError(consumer, parent, service); message != "" {
+				t.Fatalf("duplicate header rejected an otherwise supported route: %s", message)
+			}
+
+			// These conversions exercise header matching without resolving a backend.
+			rule.BackendRefs = nil
+			duplicate, _, err := convertHTTPRoute(RouteContext{}, rule, consumer, 0, routeConversionWaypointConsumer)
+			if err != nil {
+				t.Fatal(err)
+			}
+			headers := duplicate.Match[0].Headers
+			first := headers["X_Request-ID"]
+			if _, exact := first.GetMatchType().(*istio.StringMatch_Exact); !exact || first.GetExact() != "sample" || len(headers) != 1 {
+				t.Fatalf("expected only the first exact match, got %v", headers)
+			}
+
+			rule.Matches[0].Headers = rule.Matches[0].Headers[:1]
+			single, _, err := convertHTTPRoute(RouteContext{}, rule, consumer, 1, routeConversionWaypointConsumer)
+			if err != nil {
+				t.Fatal(err)
+			}
+			routes := []*istio.HTTPRoute{single, duplicate}
+			sortHTTPRoutes(routes)
+			if routes[0] != single {
+				t.Fatal("duplicate header incorrectly took precedence over the preceding single-header rule")
+			}
+		})
+	}
+
+	for _, tc := range []struct {
+		name   string
+		update func(*gatewayv1.HTTPRouteRule)
+	}{
+		{"literal response header", nil},
+		{"missing response modifier", func(r *gatewayv1.HTTPRouteRule) { r.Filters = nil }},
+		{"request mutation", func(r *gatewayv1.HTTPRouteRule) { r.Filters[0].Type = gatewayv1.HTTPRouteFilterRequestHeaderModifier }},
+		{"mirror", func(r *gatewayv1.HTTPRouteRule) { r.Filters[0].Type = gatewayv1.HTTPRouteFilterRequestMirror }},
+		{"redirect", func(r *gatewayv1.HTTPRouteRule) { r.Filters[0].Type = gatewayv1.HTTPRouteFilterRequestRedirect }},
+		{"rewrite", func(r *gatewayv1.HTTPRouteRule) { r.Filters[0].Type = gatewayv1.HTTPRouteFilterURLRewrite }},
+		{"unknown action", func(r *gatewayv1.HTTPRouteRule) { r.Filters[0].Type = "NewAction" }},
+		{"framing response header", func(r *gatewayv1.HTTPRouteRule) {
+			r.Filters[0].ResponseHeaderModifier.Set[0].Name = "Transfer-Encoding"
+		}},
+		{"regex path match", func(r *gatewayv1.HTTPRouteRule) {
+			r.Matches[0].Path = &gatewayv1.HTTPPathMatch{Type: ptr.Of(gatewayv1.PathMatchRegularExpression), Value: ptr.Of("/items/[0-9]+")}
