+// Check the raw destinations used by ambient clients, even when the gateway
+// endpoint view cannot resolve a weighted waypoint to a hostname.
+func waypointConsumerUsesPrimary(service *workloadapi.Service, key model.WaypointKey) bool {
+	primary := service.GetWaypoint()
+	ref, ok := model.WaypointReferenceFromGatewayAddress(primary)
+	if !ok || !ref.Matches(key) {
+		return false
+	}
+	weighted := service.GetWeightedWaypoints()
+	if len(weighted) == 0 {
+		return true
+	}
+	primaryReceivesTraffic := false
+	for _, waypoint := range weighted {
+		if waypoint.GetWeight() == 0 {
+			continue
+		}
+		if !googleproto.Equal(waypoint.GetDestination(), primary) {
+			return false
+		}
+		primaryReceivesTraffic = true
+	}
+	return primaryReceivesTraffic
+}
